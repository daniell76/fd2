88,"faction":"enemy","classId":4,"moveMode":"foot","aiMode":0,"aiTargetX":0,"aiTargetY":0,"aiChestIdx":1,"level":6,"x":1,"y":30,"maxHp":216,"maxMp":0,"baseAp":102,"baseDp":48,"baseDx":36,"mv":4,"items":[46,146],"spells":[],"waveGroup":4,"isBoss":false,"drop":{"type":"gold","value":5000}}],"dialogues":[[{"speaker":14,"boxPos":"bottom","lines":[[557,563,341,462,506,300,370,345,387,568,569,751,395],[181,505,503,504,367,497,490,341,581,605,569,65,401],[181,199,395,151,613,356,357,486,559,584,584,560]],"speakerNameZh":"珊","speakerGlyphs":[63],"portraitId":14,"linesZhTw":["『過了這山道，就到我們位在","　北森林的城鎮了。你們可以","　先在那裡休息一下……』"],"linesZhCn":["『过了这山道，就到我们位在","　北森林的城镇了。你们可以","　先在那里休息一下……』"],"linesEn":["Once we make it through this mountain pass, we'll reach our town in the North Forest.","You can all take a well-deserved rest there..."]},{"speaker":1,"boxPos":"bottom","lines":[[557,591,370,493,651,400,98,470,342,560]],"speakerNameZh":"哈諾","speakerGlyphs":[38,39],"portraitId":1,"linesZhTw":["『瞧，前面有人呢！』"],"linesZhCn":["『瞧，前面有人呢！』"],"linesEn":["Look, there's someone up ahead!"]},{"speaker":13,"boxPos":"bottom","lines":[[557,701,180,712,343,486,125,611,139,98,370],[181,465,400,584,584,560]],"speakerNameZh":"貝克威","speakerGlyphs":[60,61,62],"portraitId":13,"linesZhTw":["『咦？又是一大群獸人，","　還有……』"],"linesZhCn":["『咦？又是一大群兽人，","　还有……』"],"linesEn":["Huh? Another swarm of orcs!","And there's..."]},{"speaker":17,"boxPos":"top","lines":[[557,691,657,370,400,850,341,400,850,341,342],[181,850,259,464,342,560]],"speakerNameZh":"米亞斯多德","speakerGlyphs":[69,43,45,70,71],"portraitId":17,"linesZhTw":["『哎呀，有救了有救了！","　救命啊！』"],"linesZhCn":["『哎呀，有救了有救了！","　救命啊！』"],"linesEn":["Oh, thank the heavens! I'm saved!","Help! Somebody help me!"]},{"speaker":14,"boxPos":"bottom","lines":[[557,605,629,411,344,458,340,139,98,904,135,470,180],[181,568,369,659,529,300,370],[181,606,607,831,914,568,342,560]],"speakerNameZh":"珊","speakerGlyphs":[63],"portraitId":14,"linesZhTw":["『你為什麼會被獸人追殺呢？","　我好想知道，","　趕快告訴我！』"],"linesZhCn":["『你为什么会被兽人追杀呢？","　我好想知道，","　赶快告诉我！』"],"linesEn":["Why are those orcs chasing you down?","I'm dying to know—hurry up and tell me!"]},{"speaker":17,"boxPos":"top","lines":[[557,697,437,605,428,373,778,462,608,139,98,850,568],[181,486,259,370,568,346,878,831,914,605,629,411,344],[181,465,65,401,1246,548,831,914,605,486,463,125,923]],"speakerNameZh":"米亞斯多德","speakerGlyphs":[69,43,45,70,71],"portraitId":17,"linesZhTw":["『如果你能打敗這些獸人救我","　一命，我不但告訴你為什麼","　還可以額外告訴你一個大秘"],"linesZhCn":["『如果你能打败这些兽人救我","　一命，我不但告诉你为什么","　还可以额外告诉你一个大秘"],"linesEn":["If you defeat these orcs and save my neck, not only will I tell you why...","...I'll also let you in on a massive secret!"]},{"speaker":17,"boxPos":"top","lines":[[181,547,342,560]],"speakerNameZh":"米亞斯多德","speakerGlyphs":[69,43,45,70,71],"portraitId":17,"linesZhTw":["　密！』"],"linesZhCn":["　密！』"],"linesEn":["A huge secret, I swear!"]},{"speaker":14,"boxPos":"bottom","lines":[[557,657,342,561,381,579,738,400,956,370],[181,568,981,866,584,584,560]],"speakerNameZh":"珊","speakerGlyphs":[63],"portraitId":14,"linesZhTw":["『呀！聽起來很有趣，","　我答應……』"],"linesZhCn":["『呀！听起来很有趣，","　我答应……』"],"linesEn":["Ooh! That sounds fascinating!","Deal, I'll—"]},{"speaker":13,"boxPos":"bottom","lines":[[557,644,342],[181,346,334,468,125,1016,571,876,316,720,584,584,560]],"speakerNameZh":"貝克威","speakerGlyphs":[60,61,62],"portraitId":13,"linesZhTw":["『喂！","　不要給大夥兒找麻煩……』"],"linesZhCn":["『喂！","　不要给大伙儿找麻烦……』"],"linesEn":["Hey!","Don't go dragging everyone into unnecessary trouble..."]},{"speaker":4,"boxPos":"bottom","lines":[[557,399,762,763,370,936,740,568,569,997,690,334,563],[181,462,506,300,370,777,815,610,507,462,608,139,98],[181,693,399,411,344,346,369,581]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『沒關係，反正我們急著要過","　這山道，順便擺平這些獸人","　也沒什麼不好。"],"linesZhCn":["『没关系，反正我们急着要过","　这山道，顺便摆平这些兽人","　也没什么不好。"],"linesEn":["It's fine. We need to push through this pass anyway, so clearing out some orcs along the way does us no harm."]},{"speaker":4,"boxPos":"bottom","lines":[[181,36,37,370,568,534,367,399,950,358,180,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["　索爾，我說的沒錯吧？』"],"linesZhCn":["　索尔，我说的没错吧？』"],"linesEn":["Right, Thor?"]},{"speaker":0,"boxPos":"bottom","lines":[[557,43,44,45,370,605,562,579,562,1247,314,568,341],[181,346,563,893,554,462,344,807,1248,1036,1249,569,534],[181,391,345,391,342,135,464,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『亞雷斯，你越來越瞭解我了","　不過何必這麼囉唆─咱們說","　上就上！殺啊！』"],"linesZhCn":["『亚雷斯，你越来越瞭解我了","　不过何必这么啰唆─咱们说","　上就上！杀啊！』"],"linesEn":["Ares, you're reading my mind these days!","No need to waste breath talking—when it's time to fight, we charge! Attack!"]},{"speaker":4,"boxPos":"bottom","lines":[[557,462,188,291,589,343,584,584,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『這小子真是……』"],"linesZhCn":["『这小子真是……』"],"linesEn":["Good grief, this kid never changes..."]}],[{"speaker":103,"boxPos":"top","lines":[[557,65,102,584],[181,878,343,465,399,400,365,146,584,584,560]],"speakerSlot":15,"speakerNameZh":"獸人隊長","speakerGlyphs":[139,98,140,141],"portraitId":103,"linesZhTw":["『可惡…","　但是還沒有結束……』"],"linesZhCn":["『可恶…","　但是还没有结束……』"],"linesEn":["Curse you...","This isn't over yet...!"]}],[{"speaker":17,"boxPos":"top","lines":[[557,584,584,568,346,977,255,584,584],[181,321,322,367,923,547,584,584],[181,584,584,464,584,584,560]],"speakerNameZh":"米亞斯多德","speakerGlyphs":[69,43,45,70,71],"portraitId":17,"linesZhTw":["『……我不甘心……","　寶石的秘密……","　……啊……』"],"linesZhCn":["『……我不甘心……","　宝石的秘密……","　……啊……』"],"linesEn":["...No... Not like this...","The secret of the gems...","...Gah...!"]}],[{"speaker":17,"boxPos":"top","lines":[[557,568,614,827,69,43,45,70,71,581],[181,1207,82,750,751,367,678,679,370],[181,568,755,428,875,310,486,259,581,560]],"speakerNameZh":"米亞斯多德","speakerGlyphs":[69,43,45,70,71],"portraitId":17,"linesZhTw":["『我叫做米亞斯多德。","　感謝各位的幫忙，","　我才能撿回一命。』"],"linesZhCn":["『我叫做米亚斯多德。","　感谢各位的帮忙，","　我才能捡回一命。』"],"linesEn":["My name is Miastod.","Thank you all so much for lending a hand—I barely made it out alive!"]},{"speaker":14,"boxPos":"bottom","lines":[[557,69,43,584,369,807,1248,367,902,264,370],[181,605,346,343,534,370,850,341,605,605,345,458,831],[181,914,568,569,411,344,125,923,547,338,180]],"speakerNameZh":"珊","speakerGlyphs":[63],"portraitId":14,"linesZhTw":["『米亞…好囉唆的名字，","　你不是說，救了你你就會告","　訴我們什麼大秘密嗎？"],"linesZhCn":["『米亚…好啰唆的名字，","　你不是说，救了你你就会告","　诉我们什么大秘密吗？"],"linesEn":["Mia-whatever... what a mouthful of a name!","Didn't you promise that if we saved you, you'd tell us a great big secret?"]},{"speaker":14,"boxPos":"bottom","lines":[[181,607,534,358,342,560]],"speakerNameZh":"珊","speakerGlyphs":[63],"portraitId":14,"linesZhTw":["　快說吧！』"],"linesZhCn":["　快说吧！』"],"linesEn":["Well, spit it out!"]},{"speaker":17,"boxPos":"top","lines":[[557,615,370,174,260,462,463,923,547,605,569,346],[181,486,360,458,400,754,956,370,346,563,568,465,343],[181,534,455,579,369,341,581]],"speakerNameZh":"米亞斯多德","speakerGlyphs":[69,43,45,70,71],"portraitId":17,"linesZhTw":["『嘿，其實這個秘密你們不","　一定會有興趣，不過我還是","　說出來好了。"],"linesZhCn":["『嘿，其实这个秘密你们不","　一定会有兴趣，不过我还是","　说出来好了。"],"linesEn":["Heh, I'm not entirely sure it'll interest you, but a promise is a promise."]},{"speaker":17,"boxPos":"top","lines":[[181,1250,266,285,613,568,951,561,387,139,98,1001,140],[181,367,1251,652,370,1252,569,334,364,435,99,100,497],[181,490,38,45,69,37,584,584,560]],"speakerNameZh":"米亞斯多德","speakerGlyphs":[69,43,45,70,71],"portraitId":17,"linesZhTw":["　昨天夜裡我偷聽到獸人部隊","　的談話，牠們要進攻精靈城","　鎮哈斯米爾……』"],"linesZhCn":["　昨天夜里我偷听到兽人部队","　的谈话，它们要进攻精灵城","　镇哈斯米尔……』"],"linesEn":["Last night, I overheard the orc ranks talking...","They're preparing to launch an assault on the elven town of Hasmir!"]}],[{"speaker":13,"boxPos":"bottom","lines":[[557,411,344,342,151,346,343,568,569,367,938,1242],[181,338,180,560]],"speakerNameZh":"貝克威","speakerGlyphs":[60,61,62],"portraitId":13,"linesZhTw":["『什麼！那不是我們的故鄉","　嗎？』"],"linesZhCn":["『什么！那不是我们的故乡","　吗？』"],"linesEn":["What?! Isn't that our hometown?!"]},{"speaker":14,"boxPos":"bottom","lines":[[557,833,341,370,568,569,334,606,607,310,380,1253],[181,831,490,163,569,755,279,342,560]],"speakerNameZh":"珊","speakerGlyphs":[63],"portraitId":14,"linesZhTw":["『糟了，我們要趕快回去警","　告鎮民們才行！』"],"linesZhCn":["『糟了，我们要赶快回去警","　告镇民们才行！』"],"linesEn":["Oh no! We have to rush back and warn everyone immediately!"]},{"speaker":11,"boxPos":"bottom","lines":[[557,38,45,69,37,346,343,751,395,505,503,504],[181,367,99,100,634,497,338,180,462,65,885,155,341],[181,139,98,170,411,344,575,576,400,670,214,435,373]],"speakerNameZh":"索菲亞","speakerGlyphs":[36,57,43],"portraitId":11,"linesZhTw":["『哈斯米爾不是位在北森林","　的精靈都城嗎？這可奇怪了","　獸人族什麼時候有膽量攻打"],"linesZhCn":["『哈斯米尔不是位在北森林","　的精灵都城吗？这可奇怪了","　兽人族什么时候有胆量攻打"],"linesEn":["Isn't Hasmir the grand elven capital in the North Forest? How peculiar..."]},{"speaker":11,"boxPos":"bottom","lines":[[181,99,100,170,341,180,560]],"speakerNameZh":"索菲亞","speakerGlyphs":[36,57,43],"portraitId":11,"linesZhTw":["　精靈族了？』"],"linesZhCn":["　精灵族了？』"],"linesEn":["Since when did the orcs muster the courage to wage war on the elven race?"]},{"speaker":17,"boxPos":"top","lines":[[557,878,568,555,260,658,387,791,721,1254,125,367],[181,139,98,1001,140,1255,365,370,1252,569,714,671,346],[181,343,395,125,1090,1256,358,180,560]],"speakerNameZh":"米亞斯多德","speakerGlyphs":[69,43,45,70,71],"portraitId":17,"linesZhTw":["『但我確實看到相當龐大的","　獸人部隊集結，牠們總該不","　是在大露營吧？』"],"linesZhCn":["『但我确实看到相当庞大的","　兽人部队集结，它们总该不","　是在大露营吧？』"],"linesEn":["All I know is I saw an enormous force of orcs gathering.","They certainly weren't assembling for a peaceful camping trip!"]},{"speaker":13,"boxPos":"bottom","lines":[[557,462,346,296,334,370],[181,568,569,606,607,493,491,38,45,69,37,370],[181,678,99,100,170,373,315,139,98,125,361,581,560]],"speakerNameZh":"貝克威","speakerGlyphs":[60,61,62],"portraitId":13,"linesZhTw":["『這不重要，","　我們趕快前往哈斯米爾，","　幫精靈族打退獸人大軍。』"],"linesZhCn":["『这不重要，","　我们赶快前往哈斯米尔，","　帮精灵族打退兽人大军。』"],"linesEn":["That doesn't matter right now!","We must make haste for Hasmir and help our people drive back the horde!"]},{"speaker":13,"boxPos":"bottom","lines":[[557,346,369,692,855,370],[181,462,310,712,334,316,720,605,569,341,584,584,560]],"speakerNameZh":"貝克威","speakerGlyphs":[60,61,62],"portraitId":13,"linesZhTw":["『不好意思，","　這回又要麻煩你們了……』"],"linesZhCn":["『不好意思，","　这回又要麻烦你们了……』"],"linesEn":["I'm so sorry...","It looks like we're burdening you all once again..."]},{"speaker":0,"boxPos":"bottom","lines":[[557,843,654,343,726,727,367,536,370,568,569,672],[181,428,1257,118,1258,1259,470,342,568,569,607,391,794],[181,358,370,334,346,654,345,589,367,579,346,975,341]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『既然是朋友的事，我們怎","　能袖手旁觀呢！我們快上路","　吧，要不然就真的來不及了"],"linesZhCn":["『既然是朋友的事，我们怎","　能袖手旁观呢！我们快上路","　吧，要不然就真的来不及了"],"linesEn":["When our friends need us, how could we ever just stand by?","Let's move out right away..."]},{"speaker":0,"boxPos":"bottom","lines":[[181,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["　！』"],"linesZhCn":["　！』"],"linesEn":["...or we really will be too late!"]}]]}