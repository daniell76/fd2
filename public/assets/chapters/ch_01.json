,128],"portraitId":96,"spriteGroup":96,"faction":"enemy","classId":7,"moveMode":"foot","aiMode":0,"aiTargetX":0,"aiTargetY":0,"aiChestIdx":1,"level":3,"x":15,"y":0,"maxHp":42,"maxMp":0,"baseAp":21,"baseDp":3,"baseDx":3,"mv":4,"items":[0,128],"spells":[],"waveGroup":3,"isBoss":false,"drop":null},{"index":22,"urecIndex":22,"uid":8,"nameZh":"希莉亞","nameGlyphs":[51,52,43],"classNameZh":"弓兵","classGlyphs":[116,94],"portraitId":8,"spriteGroup":8,"faction":"player","classId":4,"moveMode":"foot","aiMode":0,"aiTargetX":0,"aiTargetY":0,"aiChestIdx":1,"level":3,"x":22,"y":4,"maxHp":44,"maxMp":0,"baseAp":15,"baseDp":6,"baseDx":6,"mv":4,"items":[44,129],"spells":[],"waveGroup":4,"isBoss":false,"drop":null}],"dialogues":[[{"speaker":4,"boxPos":"top","lines":[[557,568,569,339,449,660,87,74,71,490,341,581],[181,561,534,462,613,343,626,514,811,812,813,367,497],[181,490,370,568,569,65,401,395,462,613,814,486,559]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『我們已經抵達羅德鎮了。","　聽說這裡是沿岸最繁榮的城","　鎮，我們可以在這裡歇一下"],"linesZhCn":["『我们已经抵达罗德镇了。","　听说这里是沿岸最繁荣的城","　镇，我们可以在这里歇一下"],"linesEn":["We have arrived at Rhodes.","They say it's the most bustling town on the coast. We can rest here for a bit,"]},{"speaker":4,"boxPos":"top","lines":[[181,370,777,815,387,453,431,613,373,561,486,559,438],[181,357,584,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["　，順便到酒店裡打聽一下消","　息…』"],"linesZhCn":["　，顺便到酒店里打听一下消","　息…』"],"linesEn":["and stop by the tavern to gather some news..."]}],[{"speaker":0,"boxPos":"bottom","lines":[[557,43,44,45,370,568,658,605,367,816,601,400,817],[181,462,613,293,818,463,98,634,399,400,370],[181,784,616,343,148,143,497,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『亞雷斯，我看你的情報有誤","　這裡連半個人都沒有，","　倒像是座鬼城！』"],"linesZhCn":["『亚雷斯，我看你的情报有误","　这里连半个人都没有，","　倒像是座鬼城！』"],"linesEn":["Your intel seems way off, Ares.","There's not a soul in sight—it's like a ghost town!"]},{"speaker":9,"boxPos":"top","lines":[[557,369,65,709,584,560]],"speakerNameZh":"悠妮","speakerGlyphs":[53,54],"portraitId":9,"linesZhTw":["『好可怕…』"],"linesZhCn":["『好可怕…』"],"linesEn":["It's so creepy..."]},{"speaker":1,"boxPos":"bottom","lines":[[557,462,65,155,341,370,391,819,568,647,602,775,579],[181,462,613,460,453,367,575,576,370,490,391,465,685],[181,686,367,738,464,342,672,344,458,584,560]],"speakerNameZh":"哈諾","speakerGlyphs":[38,39],"portraitId":1,"linesZhTw":["『這可怪了，上次我和老爹來","　這裡買酒的時候，鎮上還熱","　鬧的很啊！怎麼會…』"],"linesZhCn":["『这可怪了，上次我和老爹来","　这里买酒的时候，镇上还热","　闹的很啊！怎么会…』"],"linesEn":["Strange... When the old man and I came here for ale, this place was teeming with life!","What on earth happened?"]}],[{"speaker":134,"boxPos":"top","lines":[[557,464,342,820,127,579,341,342,607,821,464,342,560]],"speakerSlot":5,"speakerNameZh":"男村民","speakerGlyphs":[164,162,163],"portraitId":134,"linesZhTw":["『啊！強盜來了！快逃啊！』"],"linesZhCn":["『啊！强盗来了！快逃啊！』"],"linesEn":["Bandits! The bandits are here! Run for your lives!"]},{"speaker":0,"boxPos":"bottom","lines":[[557,352,352,342,568,569,346,343,820,127,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『等等！我們不是強盜！』"],"linesZhCn":["『等等！我们不是强盗！』"],"linesEn":["Wait! We're not bandits!"]},{"speaker":134,"boxPos":"top","lines":[[557,605,569,346,343,820,127,370],[181,151,605,569,343,579,680,411,344,367,180,560]],"speakerSlot":5,"speakerNameZh":"男村民","speakerGlyphs":[164,162,163],"portraitId":134,"linesZhTw":["『你們不是強盜，","　那你們是來幹什麼的？』"],"linesZhCn":["『你们不是强盗，","　那你们是来干什么的？』"],"linesEn":["If you're not bandits, then what in blazes are you doing here?"]},{"speaker":4,"boxPos":"bottom","lines":[[557,568,569,346,563,343,794,563,570,114,370],[181,659,395,490,391,356,357,486,559,623,339,342],[181,350,378,536,816,534,463,822,823,370]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『我們不過是路過此地，","　想在鎮上休息一下而已！","　請把事情說個清楚，"],"linesZhCn":["『我们不过是路过此地，","　想在镇上休息一下而已！","　请把事情说个清楚，"],"linesEn":["We're just passing through and hoped to rest our feet.","Please, tell us what happened!"]},{"speaker":4,"boxPos":"bottom","lines":[[181,534,346,360,568,569,65,401,824,750,751,486,235],[181,132,213,342,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["　說不定我們可以助各位一臂","　之力！』"],"linesZhCn":["　说不定我们可以助各位一臂","　之力！』"],"linesEn":["Perhaps we can lend you a hand!"]},{"speaker":134,"boxPos":"top","lines":[[557,825,342,605,569,462,608,188,826,129,428,827,411],[181,344,180,828,739,582,102,367,820,127,829,830,831],[181,334,395,570,575,832,620,366,490,370,490,391,367]],"speakerSlot":5,"speakerNameZh":"男村民","speakerGlyphs":[164,162,163],"portraitId":134,"linesZhTw":["『唉！你們這些小毛頭能做什","　麼？窮兇極惡的強盜團預告","　要在此時洗劫本鎮，鎮上的"],"linesZhCn":["『唉！你们这些小毛头能做什","　么？穷凶极恶的强盗团预告","　要在此时洗劫本镇，镇上的"],"linesEn":["What could a bunch of whelps like you possibly do?","A ruthless gang of bandits gave notice they'd pillage the town today!"]},{"speaker":134,"boxPos":"top","lines":[[181,98,634,821,145,341,370,568,569,343,310,579,70],[181,466,806,486,608,646,156,367,370,201,391,693,334],[181,821,353,570,114,581,605,569,693,607,821,358,370]],"speakerSlot":5,"speakerNameZh":"男村民","speakerGlyphs":[164,162,163],"portraitId":134,"linesZhTw":["　人都逃光了，我們是回來多","　帶走一些財物的，馬上也要","　逃離此地。你們也快逃吧，"],"linesZhCn":["　人都逃光了，我们是回来多","　带走一些财物的，马上也要","　逃离此地。你们也快逃吧，"],"linesEn":["Everyone else fled! We only slipped back to gather a few belongings before making our escape.","You lot should flee too—"]},{"speaker":134,"boxPos":"top","lines":[[181,334,343,772,391,341,151,611,820,127,345,833,643],[181,342,560]],"speakerSlot":5,"speakerNameZh":"男村民","speakerGlyphs":[164,162,163],"portraitId":134,"linesZhTw":["　要是碰上了那群強盜就糟啦","　！』"],"linesZhCn":["　要是碰上了那群强盗就糟啦","　！』"],"linesEn":["if those bandits catch you, you're done for!"]},{"speaker":30,"boxPos":"bottom","lines":[[557,584,584,342,342,342,560]],"speakerNameZh":"蓋亞","speakerGlyphs":[91,43],"portraitId":30,"linesZhTw":["『……！！！』"],"linesZhCn":["『……！！！』"],"linesEn":["......!!!"]}],[{"speaker":96,"boxPos":"top","lines":[[557,657,522,342],[181,568,569,834,830,831,803,575,660,87,342],[181,701,180]],"speakerSlot":11,"speakerNameZh":"盜賊","speakerGlyphs":[127,128],"portraitId":96,"linesZhTw":["『呀呼！","　我們照預告準時抵達！","　咦？"],"linesZhCn":["『呀呼！","　我们照预告准时抵达！","　咦？"],"linesEn":["Yahoo! Right on schedule, just like we promised!","Wait..."]},{"speaker":96,"boxPos":"top","lines":[[181,669,654,465,400,346,709,515,367,399,806,180,560]],"speakerSlot":11,"speakerNameZh":"盜賊","speakerGlyphs":[127,128],"portraitId":96,"linesZhTw":["　居然還有不怕死的沒走？』"],"linesZhCn":["　居然还有不怕死的没走？』"],"linesEn":["Some fools actually had the nerve to stick around?"]},{"speaker":134,"boxPos":"top","lines":[[557,464,342,820,127,579,341,342],[181,426,643,342,560]],"speakerSlot":5,"speakerNameZh":"男村民","speakerGlyphs":[164,162,163],"portraitId":134,"linesZhTw":["『啊！強盜來了！","　完啦！』"],"linesZhCn":["『啊！强盗来了！","　完啦！』"],"linesEn":["Eeeek! Bandits! We're doomed!"]},{"speaker":96,"boxPos":"top","lines":[[557,568,569,346,343,534,563,370,568,569,579,367,575],[181,576,346,835,400,98,836,395,490,391,338,180],[181,605,569,343,539,367,346,317,720,341,342,560]],"speakerSlot":11,"speakerNameZh":"盜賊","speakerGlyphs":[127,128],"portraitId":96,"linesZhTw":["『我們不是說過，我們來的時","　候不准有人留在鎮上嗎？","　你們是活的不耐煩了！』"],"linesZhCn":["『我们不是说过，我们来的时","　候不准有人留在镇上吗？","　你们是活的不耐烦了！』"],"linesEn":["Didn't we say nobody was allowed to stay in town when we arrived?","You tired of living, is that it?!"]},{"speaker":134,"boxPos":"top","lines":[[557,584,464,370,820,127,125,98,370],[181,350,379,568,569,486,201,370],[181,401,733,346,767,341,584,560]],"speakerSlot":5,"speakerNameZh":"男村民","speakerGlyphs":[164,162,163],"portraitId":134,"linesZhTw":["『…啊，強盜大人，","　請放我們一馬，","　以後不敢了…』"],"linesZhCn":["『…啊，强盗大人，","　请放我们一马，","　以后不敢了…』"],"linesEn":["M-Mercy, kind bandits! Spare our lives!","We'll never do it again..."]},{"speaker":4,"boxPos":"bottom","lines":[[557,462,608,820,127,589,837,111,464,342,36,37,370],[181,568,569,579,457,838,175,569,486,839,342,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『這些強盜真猖狂啊！索爾，","　我們來教訓他們一頓！』"],"linesZhCn":["『这些强盗真猖狂啊！索尔，","　我们来教训他们一顿！』"],"linesEn":["What arrogant scum! Thor, let's teach these thugs a lesson!"]},{"speaker":0,"boxPos":"bottom","lines":[[557,411,344,457,838,342,346,689,468,462,608,612,609],[181,840,841,367,144,458,370,378,175,569,362,656,341],[181,313,534,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『什麼教訓！不用給這些傢伙","　悔改的機會，把他們全宰了","　再說！』"],"linesZhCn":["『什么教训！不用给这些家伙","　悔改的机会，把他们全宰了","　再说！』"],"linesEn":["A lesson?! Scoundrels like this don't deserve mercy.","Wipe them out, every last one!"]},{"speaker":1,"boxPos":"bottom","lines":[[557,568,842,542,342,560]],"speakerNameZh":"哈諾","speakerGlyphs":[38,39],"portraitId":1,"linesZhTw":["『我贊成！』"],"linesZhCn":["『我赞成！』"],"linesEn":["Couldn't agree more!"]},{"speaker":96,"boxPos":"top","lines":[[557,691,657,342,151,611,188,609,291,534,334,378],[181,568,569,362,656,341,470,342,560]],"speakerSlot":11,"speakerNameZh":"盜賊","speakerGlyphs":[127,128],"portraitId":96,"linesZhTw":["『哎呀！那群小伙子說要把","　我們全宰了呢！』"],"linesZhCn":["『哎呀！那群小伙子说要把","　我们全宰了呢！』"],"linesEn":["Well, well! Listen to these youngsters talk about wiping us out!"]},{"speaker":96,"boxPos":"top","lines":[[557,369,65,709,657,342,568,369,709,342,560]],"speakerSlot":12,"speakerNameZh":"盜賊","speakerGlyphs":[127,128],"portraitId":96,"linesZhTw":["『好可怕呀！我好怕！』"],"linesZhCn":["『好可怕呀！我好怕！』"],"linesEn":["Ooh, terrifying! I'm shaking in my boots!"]},{"speaker":96,"boxPos":"top","lines":[[557,843,654,697,570,370,568,569,345,632,175,569,844],[181,463,732,118,342,391,342,560]],"speakerSlot":11,"speakerNameZh":"盜賊","speakerGlyphs":[127,128],"portraitId":96,"linesZhTw":["『既然如此，我們就陪他們玩","　個兩手！上！』"],"linesZhCn":["『既然如此，我们就陪他们玩","　个两手！上！』"],"linesEn":["In that case, let's play with these pups! Get 'em!"]}],[{"speaker":96,"boxPos":"top","lines":[[557,701,342,702,703,569,395,680,411,344,180],[181,175,569,845,671,378,536,816,673,369,341,358],[181,342,560]],"speakerSlot":21,"speakerNameZh":"盜賊","speakerGlyphs":[127,128],"portraitId":96,"linesZhTw":["『咦！弟兄們在幹什麼？","　他們早該把事情辦好了吧","　！』"],"linesZhCn":["『咦！弟兄们在干什么？","　他们早该把事情办好了吧","　！』"],"linesEn":["Hey, what are the boys doing? They should've wrapped things up by now!"]},{"speaker":96,"boxPos":"top","lines":[[557,369,616,647,683,98,373,367,740,381,846,470,342],[181,560]],"speakerSlot":22,"speakerNameZh":"盜賊","speakerGlyphs":[127,128],"portraitId":96,"linesZhTw":["『好像和別人打的正起勁呢！","　』"],"linesZhCn":["『好像和别人打的正起劲呢！","　』"],"linesEn":["Looks like they've run into someone and got a real brawl going!"]},{"speaker":96,"boxPos":"top","lines":[[557,568,658,387,400,847,848,132,849,523,462,613,821],[181,579,470,342,568,569,199,373,363,341,175,569,313],[181,534,342,560]],"speakerSlot":23,"speakerNameZh":"盜賊","speakerGlyphs":[127,128],"portraitId":96,"linesZhTw":["『我看到有漏網之魚向這裡逃","　來呢！我們先打發了他們再","　說！』"],"linesZhCn":["『我看到有漏网之鱼向这里逃","　来呢！我们先打发了他们再","　说！』"],"linesEn":["Look, some stragglers are fleeing our way! Let's finish them off first!"]},{"speaker":133,"boxPos":"top","lines":[[557,850,259,464,342,462,613,712,400,820,127,455,371],[181,341,342,560]],"speakerSlot":8,"speakerNameZh":"女村民","speakerGlyphs":[161,162,163],"portraitId":133,"linesZhTw":["『救命啊！這裡又有強盜出現","　了！』"],"linesZhCn":["『救命啊！这里又有强盗出现","　了！』"],"linesEn":["Help! Bandits here, too!"]},{"speaker":4,"boxPos":"bottom","lines":[[557,65,102,370,399,659,387,389,98,669,654,94,851],[181,732,794,584,584,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『可惡，沒想到敵人居然兵分","　兩路……』"],"linesZhCn":["『可恶，没想到敌人居然兵分","　两路……』"],"linesEn":["Curse it... They split their forces into two flanks!"]},{"speaker":0,"boxPos":"bottom","lines":[[557,346,852,672,696,370,386,659,673,81,604,850,151],[181,608,306,853,367,669,163,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『不管怎樣，得想辦法援救那","　些無辜的居民！』"],"linesZhCn":["『不管怎样，得想办法援救那","　些无辜的居民！』"],"linesEn":["Whatever happens, we must protect those innocent villagers!"]},{"speaker":4,"boxPos":"bottom","lines":[[557,672,344,673,470,180,36,37,584,584,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『怎麼辦呢？索爾……』"],"linesZhCn":["『怎么办呢？索尔……』"],"linesEn":["What's our move, Thor...?"]},{"speaker":0,"boxPos":"bottom","lines":[[557,644,342,605,569,370,491,461,854,533,821,358,342],[181,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『喂！你們，往東南邊逃吧！","　』"],"linesZhCn":["『喂！你们，往东南边逃吧！","　』"],"linesEn":["Hey! You over there, run to the southeast!"]},{"speaker":134,"boxPos":"top","lines":[[557,369,367,342,125,609,571,491,461,854,533,821,358],[181,342,560]],"speakerSlot":7,"speakerNameZh":"男村民","speakerGlyphs":[164,162,163],"portraitId":134,"linesZhTw":["『好的！大伙兒往東南邊逃吧","　！』"],"linesZhCn":["『好的！大伙儿往东南边逃吧","　！』"],"linesEn":["Understood! Everyone, flee to the southeast!"]}],[{"speaker":0,"boxPos":"bottom","lines":[[557,808,809,464,810,180,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『奈野啊捏？』"],"linesZhCn":["『奈野啊捏？』"],"linesEn":["What the heck?!"]}],[{"speaker":133,"boxPos":"top","lines":[[557,82,82,750,751,367,678,824,370],[181,462,343,568,569,367,486,448,188,692,855,370],[181,350,706,559,358,581,560]],"speakerSlot":6,"speakerNameZh":"女村民","speakerGlyphs":[161,162,163],"portraitId":133,"linesZhTw":["『謝謝各位的幫助，","　這是我們的一點小意思，","　請收下吧。』"],"linesZhCn":["『谢谢各位的帮助，","　这是我们的一点小意思，","　请收下吧。』"],"linesEn":["Thank you all so much for saving us.","Please take this small token of our gratitude."]}],[{"speaker":133,"boxPos":"top","lines":[[557,82,82,750,751,367,678,824,370],[181,725,568,569,821,563,486,620,581,560]],"speakerSlot":6,"speakerNameZh":"女村民","speakerGlyphs":[161,162,163],"portraitId":133,"linesZhTw":["『謝謝各位的幫助，","　讓我們逃過一劫。』"],"linesZhCn":["『谢谢各位的帮助，","　让我们逃过一劫。』"],"linesEn":["Thank you for your help. You saved our lives today."]}],[{"speaker":8,"boxPos":"top","lines":[[557,369,856,342,369,856,342,373,367,589,648,649,342],[181,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『好棒！好棒！打的真漂亮！","　』"],"linesZhCn":["『好棒！好棒！打的真漂亮！","　』"],"linesEn":["Bravo! Splendid! That was a magnificent fight!"]},{"speaker":0,"boxPos":"bottom","lines":[[557,701,180,857,613,858,455,579,367,809,859,129,180],[181,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『咦？哪裡蹦出來的野丫頭？","　』"],"linesZhCn":["『咦？哪里蹦出来的野丫头？","　』"],"linesEn":["Huh? Where did this tomboy pop out from?"]},{"speaker":8,"boxPos":"top","lines":[[557,534,652,668,761,448,370],[181,568,65,346,343,809,859,129,581],[181,860,755,605,569,395,373,367,575,576,370]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『說話客氣點，","　我可不是野丫頭。","　剛才你們在打的時候，"],"linesZhCn":["『说话客气点，","　我可不是野丫头。","　刚才你们在打的时候，"],"linesEn":["Watch your mouth! I am no tomboy.","While you were fighting, I was watching the whole thing from inside the house."]},{"speaker":8,"boxPos":"top","lines":[[181,568,486,861,634,862,395,764,291,613,658,370],[181,589,343,658,341,486,355,369,863,581,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["　我一直都躲在屋子裡看，","　真是看了一場好戲。』"],"linesZhCn":["　我一直都躲在屋子里看，","　真是看了一场好戏。』"],"linesEn":["Quite the entertaining spectacle!"]},{"speaker":4,"boxPos":"bottom","lines":[[557,188,864,370,583,367,670,214,65,589,125,581],[181,400,411,344,568,569,428,436,708,367,338,180,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『小姐，妳的膽量可真大。","　有什麼我們能效勞的嗎？』"],"linesZhCn":["『小姐，你的胆量可真大。","　有什么我们能效劳的吗？』"],"linesEn":["You certainly have guts, young lady. Is there something we can do for you?"]},{"speaker":8,"boxPos":"top","lines":[[557,693,399,411,344,643,370,865,343,659,637,637,605],[181,569,370,605,569,462,344,369,367,390,118,370],[181,866,671,346,865,343,579,462,613,373,820,127,367]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『也沒什麼啦，只是想問問你","　們，你們這麼好的身手，","　應該不只是來這裡打強盜的"],"linesZhCn":["『也没什么啦，只是想问问你","　们，你们这么好的身手，","　应该不只是来这里打强盗的"],"linesEn":["Not really! I was just wondering: warriors with your skill couldn't have come here","just to swat petty bandits, could you?"]},{"speaker":8,"boxPos":"top","lines":[[181,358,180,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["　吧？』"],"linesZhCn":["　吧？』"],"linesEn":["...Right?"]},{"speaker":0,"boxPos":"bottom","lines":[[557,343,462,696,367,370,568,569,659,867,416,462,463],[181,161,729,291,367,439,868,869,370],[181,870,871,269,872,310,137,581,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『是這樣的，我們想醫治這個","　女孩子的失憶症，","　並且送她回家。』"],"linesZhCn":["『是这样的，我们想医治这个","　女孩子的失忆症，","　并且送她回家。』"],"linesEn":["As a matter of fact, we're trying to cure this girl's amnesia and get her back home."]},{"speaker":8,"boxPos":"top","lines":[[557,462,343,672,344,486,310,536,470,180,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『這是怎麼一回事呢？』"],"linesZhCn":["『这是怎么一回事呢？』"],"linesEn":["Amnesia? How did that come about?"]},{"speaker":0,"boxPos":"bottom","lines":[[557,873,874,367,579,534,370,568,569,395,503,504,875],[181,387,341,53,54,462,161,729,584,584,584,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『簡單的來說，我們在森林撿","　到了悠妮這女孩………』"],"linesZhCn":["『简单的来说，我们在森林捡","　到了悠妮这女孩………』"],"linesEn":["To put it simply, we picked Uni up in the forest..."]},{"speaker":8,"boxPos":"top","lines":[[557,875,180,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『撿？』"],"linesZhCn":["『捡？』"],"linesEn":["'Picked up'?!"]},{"speaker":0,"boxPos":"bottom","lines":[[557,346,716,346,716,370,343,876,387,341,53,54,370],[181,877,654,439,380,341,335,868,370,878,343,568,569],[181,791,792,872,343,462,201,68,125,567,367,98,370]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『不對不對，是找到了悠妮，","　雖然失去了記憶，但是我們","　相信她是這馬拉大陸的人，"],"linesZhCn":["『不对不对，是找到了悠妮，","　虽然失去了记忆，但是我们","　相信她是这马拉大陆的人，"],"linesEn":["No, no—we found her! Though she's lost her memories, we believe she's from Mara."]},{"speaker":0,"boxPos":"bottom","lines":[[181,879,760,343,880,307,745,367,776,881,693,534,346],[181,360,370,882,570,883,81,884,565,269,872,310,579],[181,581,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["　甚至是某王國的公主也說不","　定，因此設法渡海送她回來","　。』"],"linesZhCn":["　甚至是某王国的公主也说不","　定，因此设法渡海送她回来","　。』"],"linesEn":["She might even be royalty, for all we know. So we crossed the sea to bring her back."]},{"speaker":8,"boxPos":"top","lines":[[557,885,155,341,370,462,125,567,391,345,865,400,486],[181,463,43,61,45,307,745,370,623,462,463,307,745],[181,367,776,881,345,584,584,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『奇怪了，這大陸上就只有一","　個亞克斯王國，而這個王國","　的公主就……』"],"linesZhCn":["『奇怪了，这大陆上就只有一","　个亚克斯王国，而这个王国","　的公主就……』"],"linesEn":["How odd... There's only one kingdom on this entire continent—the Kingdom of Ax.","And as for the princess of Ax..."]},{"speaker":4,"boxPos":"bottom","lines":[[557,345,672,696,180,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『就怎樣？』"],"linesZhCn":["『就怎样？』"],"linesEn":["What about her?"]},{"speaker":8,"boxPos":"top","lines":[[557,399,584,399,411,344,643,581,462,696,358,370],[181,568,529,300,857,613,400,98,428,867,416,439,868],[181,869,370,568,65,401,466,605,569,380,370,346,563]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『沒…沒什麼啦。這樣吧，","　我知道哪裡有人能醫治失憶","　症，我可以帶你們去，不過"],"linesZhCn":["『没…没什么啦。这样吧，","　我知道哪里有人能医治失忆","　症，我可以带你们去，不过"],"linesEn":["N-Nothing! Forget it. Tell you what: I know someone who can cure amnesia.","I can guide you there, but... on one condition."]},{"speaker":8,"boxPos":"top","lines":[[181,584,334,886,466,486,463,887,272,403,581,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["　…要附帶一個條件喔。』"],"linesZhCn":["　…要附带一个条件喔。』"],"linesEn":["You have to agree to my terms first!"]},{"speaker":0,"boxPos":"bottom","lines":[[557,199,534,579,561,561,370],[181,568,569,458,888,214,659,673,81,367,581,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『先說來聽聽，","　我們會盡量想辦法的。』"],"linesZhCn":["『先说来听听，","　我们会尽量想办法的。』"],"linesEn":["Let's hear it first. We'll do what we can."]},{"speaker":8,"boxPos":"top","lines":[[557,174,260,693,738,873,874,370],[181,345,343,334,466,568,486,381,380,581,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『其實也很簡單，","　就是要帶我一起去。』"],"linesZhCn":["『其实也很简单，","　就是要带我一起去。』"],"linesEn":["It's simple, really: you have to take me along with you!"]}],[{"speaker":4,"boxPos":"bottom","lines":[[557,462,584,584,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『這……』"],"linesZhCn":["『这……』"],"linesEn":["Now wait just a minute..."]},{"speaker":0,"boxPos":"bottom","lines":[[557,188,864,370,462,65,346,343,369,844,367,370],[181,583,486,463,699,700,161,729,291,889,690,568,569],[181,370,890,709,458,784,125,891,403,581,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『小姐，這可不是好玩的，","　妳一個年輕女孩子跟著我們","　，恐怕會倒大楣喔。』"],"linesZhCn":["『小姐，这可不是好玩的，","　你一个年轻女孩子跟着我们","　，恐怕会倒大楣喔。』"],"linesEn":["Miss, this isn't a stroll in the park. A young girl traveling with us is only asking for trouble."]},{"speaker":8,"boxPos":"top","lines":[[557,188,658,568,367,366,252,370],[181,605,755,803,402,784,125,891,470,581]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『小看我的本領，","　你才準備倒大楣呢。"],"linesZhCn":["『小看我的本领，","　你才准备倒大楣呢。"],"linesEn":["Underestimate my skills and you'll be the one in trouble!"]},{"speaker":8,"boxPos":"top","lines":[[181,672,696,180],[181,580,346,580,642,568,367,887,272,464,180,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["　怎樣？","　接不接受我的條件啊？』"],"linesZhCn":["　怎样？","　接不接受我的条件啊？』"],"linesEn":["Well? Do you accept my terms or not?"]},{"speaker":1,"boxPos":"bottom","lines":[[557,36,37,125,892,370,371,395,820,127,693,346,529],[181,300,893,575,458,313,579,370,378,486,463,161,729],[181,291,345,462,696,392,395,462,613,797,799,894,341]],"speakerNameZh":"哈諾","speakerGlyphs":[38,39],"portraitId":1,"linesZhTw":["『索爾大哥，現在強盜也不知","　道何時會再來，把一個女孩","　子就這樣丟在這裡太危險了"],"linesZhCn":["『索尔大哥，现在强盗也不知","　道何时会再来，把一个女孩","　子就这样丢在这里太危险了"],"linesEn":["Brother Thor, who knows when the bandits might return? Leaving a girl all alone here is too dangerous."]},{"speaker":1,"boxPos":"bottom","lines":[[181,370,568,658,465,343,199,466,872,353,354,367,369],[181,581,560]],"speakerNameZh":"哈諾","speakerGlyphs":[38,39],"portraitId":1,"linesZhTw":["　，我看還是先帶她離開的好","　。』"],"linesZhCn":["　，我看还是先带她离开的好","　。』"],"linesEn":["I say we take her along for now."]},{"speaker":4,"boxPos":"bottom","lines":[[557,343,464,370,36,37,370,53,54,367,536,554,538],[181,888,607,314,359,370,341,346,381,568,569,70,629],[181,872,895,896,255,345,343,341,581,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『是啊，索爾，悠妮的事必須","　盡快解決，了不起我們多為","　她操份心就是了。』"],"linesZhCn":["『是啊，索尔，悠妮的事必须","　尽快解决，了不起我们多为","　她操份心就是了。』"],"linesEn":["He's right, Thor. We need to solve Uni's condition as quickly as possible. At worst, we'll just have to look out for her along the way."]},{"speaker":0,"boxPos":"bottom","lines":[[557,369,358,342,346,563,188,864,583,468,568,561,369],[181,370,583,343,897,749,466,794,367,370,683,468,568],[181,569,898,316,720,581,529,300,338,180,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『好吧！不過小姐妳給我聽好","　，妳是負責帶路的，別給我","　們添麻煩。知道嗎？』"],"linesZhCn":["『好吧！不过小姐你给我听好","　，你是负责带路的，别给我","　们添麻烦。知道吗？』"],"linesEn":["Fine! But listen closely, miss: you're our guide, nothing more. Don't go causing us trouble, understand?"]},{"speaker":8,"boxPos":"top","lines":[[557,399,637,638,342,806,358,806,358,370],[181,568,579,466,794,342,491,462,533,342,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『沒問題！走吧走吧，","　我來帶路！往這邊！』"],"linesZhCn":["『没问题！走吧走吧，","　我来带路！往这边！』"],"linesEn":["No problem! Come on, let's get moving! I'll lead the way—over here!"]}],[{"speaker":0,"boxPos":"bottom","lines":[[557,589,343,399,673,81,370,825,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『真是沒辦法，唉！』"],"linesZhCn":["『真是没办法，唉！』"],"linesEn":["Unbelievable... *sigh*"]}],[{"speaker":134,"boxPos":"top","lines":[[557,464,584,584,342,560]],"speakerSlot":5,"speakerNameZh":"男村民","speakerGlyphs":[164,162,163],"portraitId":134,"linesZhTw":["『啊……！』"],"linesZhCn":["『啊……！』"],"linesEn":["Aaaargh...!"]}],[{"speaker":133,"boxPos":"top","lines":[[557,899,584,464,584,584,342,560]],"speakerSlot":6,"speakerNameZh":"女村民","speakerGlyphs":[161,162,163],"portraitId":133,"linesZhTw":["『哇…啊……！』"],"linesZhCn":["『哇…啊……！』"],"linesEn":["Kyaaaah...!"]}],[{"speaker":134,"boxPos":"top","lines":[[557,464,584,584,342,560]],"speakerSlot":7,"speakerNameZh":"男村民","speakerGlyphs":[164,162,163],"portraitId":134,"linesZhTw":["『啊……！』"],"linesZhCn":["『啊……！』"],"linesEn":["Aaaargh...!"]}],[{"speaker":133,"boxPos":"top","lines":[[557,899,584,464,584,584,342,560]],"speakerSlot":8,"speakerNameZh":"女村民","speakerGlyphs":[161,162,163],"portraitId":133,"linesZhTw":["『哇…啊……！』"],"linesZhCn":["『哇…啊……！』"],"linesEn":["Kyaaaah...!"]}],[{"speaker":134,"boxPos":"top","lines":[[557,464,584,584,342,560]],"speakerSlot":9,"speakerNameZh":"男村民","speakerGlyphs":[164,162,163],"portraitId":134,"linesZhTw":["『啊……！』"],"linesZhCn":["『啊……！』"],"linesEn":["Aaaargh...!"]}],[{"speaker":133,"boxPos":"top","lines":[[557,899,584,464,584,584,342,560]],"speakerSlot":10,"speakerNameZh":"女村民","speakerGlyphs":[161,162,163],"portraitId":133,"linesZhTw":["『哇…啊……！』"],"linesZhCn":["『哇…啊……！』"],"linesEn":["Kyaaaah...!"]}]]}