el":5,"x":3,"y":39,"maxHp":356,"maxMp":0,"baseAp":260,"baseDp":175,"baseDx":55,"mv":7,"items":[17,139],"spells":[],"waveGroup":1,"isBoss":false,"drop":null}],"dialogues":[[{"speaker":0,"boxPos":"bottom","lines":[[557,589,913,98,346,590,287,367,503,504,342,462,613],[181,343,411,344,114,524,180,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『真令人不舒服的森林！這裡","　是什麼地方？』"],"linesZhCn":["『真令人不舒服的森林！这里","　是什么地方？』"],"linesEn":["What an eerie forest!","What kind of place is this?"]},{"speaker":21,"boxPos":"bottom","lines":[[557,462,343,125,567,505,524,506,1423,132,1424,367,109],[181,503,504,370,429,1135,506,1423,647,1425,547,367,503],[181,504,1206,766,1426,145,370,462,486,466,658,381,579]],"speakerNameZh":"約拿","speakerGlyphs":[77,78],"portraitId":21,"linesZhTw":["『這是大陸北方山脈之麓的黑","　森林，由於山脈和濃密的森","　林阻擋陽光，這一帶看起來"],"linesZhCn":["『这是大陆北方山脉之麓的黑","　森林，由于山脉和浓密的森","　林阻挡阳光，这一带看起来"],"linesEn":["This is the Black Forest at the foot of the northern mountains.","Because the mountains and dense canopy block out the sun, this area always looks..."]},{"speaker":21,"boxPos":"bottom","lines":[[181,714,343,1048,503,503,367,370,486,517,278,98,634],[181,346,767,279,449,570,717,581,560]],"speakerNameZh":"約拿","speakerGlyphs":[77,78],"portraitId":21,"linesZhTw":["　總是陰森森的，一般旅人都","　不敢行經此處。』"],"linesZhCn":["　总是阴森森的，一般旅人都","　不敢行经此处。』"],"linesEn":["...gloomy and foreboding.","Ordinary travelers dare not set foot here."]},{"speaker":8,"boxPos":"bottom","lines":[[557,563,341,570,114,370,693,345,607,387,515,132,153],[181,154,341,370,561,534,987,400,98,395,462,486,466],[181,971,155,156,435,113,584,584,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『過了此地，也就快到死之沼","　澤了，聽說曾有人在這一帶","　遭怪物攻擊……』"],"linesZhCn":["『过了此地，也就快到死之沼","　泽了，听说曾有人在这一带","　遭怪物攻击……』"],"linesEn":["Once we pass through here, we'll nearly reach the Swamp of Death.","I've heard people have been attacked by monsters in this area..."]},{"speaker":3,"boxPos":"bottom","lines":[[557,568,400,346,369,367,830,1207,370,125,137,334,70],[181,188,255,342,560]],"speakerNameZh":"哈瓦特","speakerGlyphs":[38,41,42],"portraitId":3,"linesZhTw":["『我有不好的預感，大家要多","　小心！』"],"linesZhCn":["『我有不好的预感，大家要多","　小心！』"],"linesEn":["I have a bad feeling about this.","Everyone, stay on your guard!"]},{"speaker":1,"boxPos":"bottom","lines":[[557,691,657,342,602,775,605,534,716,643,370,493,651],[181,437,654,400,98,579,341,342,560]],"speakerNameZh":"哈諾","speakerGlyphs":[38,39],"portraitId":1,"linesZhTw":["『哎呀！老爹你說對啦，前面","　果然有人來了！』"],"linesZhCn":["『哎呀！老爹你说对啦，前面","　果然有人来了！』"],"linesEn":["Whoa! You called it, Dad!","Someone's coming this way!"]},{"speaker":81,"boxPos":"top","lines":[[557,77,78,602,129,370,391,819,395,605,118,613,1349],[181,1427,341,346,447,702,703,370,744,266,462,1379,1380],[181,334,486,1201,736,310,579,342,803,402,642,515,358]],"speakerNameZh":"狂戰士","speakerGlyphs":[111,105,93],"portraitId":81,"linesZhTw":["『約拿老頭，上次在你手裡折","　損了不少弟兄，今天這筆帳","　要一併討回來！準備受死吧"],"linesZhCn":["『约拿老头，上次在你手里折","　损了不少弟兄，今天这笔帐","　要一并讨回来！准备受死吧"],"linesEn":["Old man Jonah! We lost many brothers to you last time!","Today, we're settling that score in full!"]},{"speaker":81,"boxPos":"top","lines":[[181,342,560]],"speakerNameZh":"狂戰士","speakerGlyphs":[111,105,93],"portraitId":81,"linesZhTw":["　！』"],"linesZhCn":["　！』"],"linesEn":["Prepare to meet your doom!"]},{"speaker":4,"boxPos":"bottom","lines":[[557,65,102,370,712,343,1048,1428,346,1429,367,515,516],[181,1398,1399,342,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『可惡，又是陰魂不散的死亡","　骷髏！』"],"linesZhCn":["『可恶，又是阴魂不散的死亡","　骷髅！』"],"linesEn":["Curse them, it's those Death Skulls again!","They just won't leave us alone!"]},{"speaker":0,"boxPos":"bottom","lines":[[557,346,529,515,539,367,612,609,370,605,569,367,1073],[181,543,345,387,570,629,622,341,342,568,744,266,674],[181,346,379,563,605,569,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『不知死活的傢伙，你們的罪","　業就到此為止了！我今天絕","　不放過你們！』"],"linesZhCn":["『不知死活的家伙，你们的罪","　业就到此为止了！我今天绝","　不放过你们！』"],"linesEn":["Reckless fools! Your evil deeds end here!","I will not let you escape today!"]}],[{"speaker":27,"boxPos":"top","lines":[[557,701,342,462,343,102,902,1400,1401,367,1100,515,516],[181,1398,1399,1102,96,94,829,464,342,175,569,592,654],[181,395,462,613,455,371,370,640,300,437,589,343,400]],"speakerNameZh":"巴拿羅西亞","speakerGlyphs":[85,78,74,86,43],"portraitId":27,"linesZhTw":["『咦！這是惡名昭彰的「死亡","　骷髏」傭兵團啊！他們竟然","　在這裡出現，難道果真是有"],"linesZhCn":["『咦！这是恶名昭彰的「死亡","　骷髅」佣兵团啊！他们竟然","　在这里出现，难道果真是有"],"linesEn":["What! It's the infamous Death Skull mercenaries!","To think they would appear here... Could someone really be..."]},{"speaker":27,"boxPos":"top","lines":[[181,98,395,110,331,584,584,560]],"speakerNameZh":"巴拿羅西亞","speakerGlyphs":[85,78,74,86,43],"portraitId":27,"linesZhTw":["　人在暗中……』"],"linesZhCn":["　人在暗中……』"],"linesEn":["...pulling the strings from the shadows?"]},{"speaker":16,"boxPos":"bottom","lines":[[557,615,342,151,65,346,343,85,78,74,86,43,1336],[181,559,338,180,589,1263,464,342,560]],"speakerNameZh":"凱拉斯","speakerGlyphs":[58,68,45],"portraitId":16,"linesZhTw":["『嘿！那可不是巴拿羅西亞閣","　下嗎？真巧啊！』"],"linesZhCn":["『嘿！那可不是巴拿罗西亚阁","　下吗？真巧啊！』"],"linesEn":["Hey! Isn't that Lord Banarossia over there?","What a coincidence!"]},{"speaker":27,"boxPos":"top","lines":[[557,464,342,605,343,58,68,45,598,342,369,486,988],[181,291,399,772,651,341,370,659,346,387,458,395,462],[181,613,774,788,605,584,584,560]],"speakerNameZh":"巴拿羅西亞","speakerGlyphs":[85,78,74,86,43],"portraitId":27,"linesZhTw":["『啊！你是凱拉斯嘛！好一陣","　子沒碰面了，想不到會在這","　裡遇見你……』"],"linesZhCn":["『啊！你是凯拉斯嘛！好一阵","　子没碰面了，想不到会在这","　里遇见你……』"],"linesEn":["Ah! Kailas! It's been quite a while.","I never expected to run into you here..."]},{"speaker":16,"boxPos":"bottom","lines":[[557,85,78,74,86,43,1336,559,370,371,395,65,428],[181,346,343,1421,1200,367,369,575,576,370,199,725,568],[181,569,314,359,341,462,678,659,1049,965,77,78,199]],"speakerNameZh":"凱拉斯","speakerGlyphs":[58,68,45],"portraitId":16,"linesZhTw":["『巴拿羅西亞閣下，現在可能","　不是敘舊的好時候，先讓我","　們解決了這幫想謀害約拿先"],"linesZhCn":["『巴拿罗西亚阁下，现在可能","　不是叙旧的好时候，先让我","　们解决了这帮想谋害约拿先"],"linesEn":["Lord Banarossia, now is hardly the time to reminisce.","First, let us deal with these villains plotting against Master Jonah..."]},{"speaker":16,"boxPos":"bottom","lines":[[181,258,367,102,1032,313,534,581,560]],"speakerNameZh":"凱拉斯","speakerGlyphs":[58,68,45],"portraitId":16,"linesZhTw":["　生的惡徒再說。』"],"linesZhCn":["　生的恶徒再说。』"],"linesEn":["...and settle everything else later!"]},{"speaker":27,"boxPos":"top","lines":[[557,77,78,199,258,693,395,462,613,180,369,582,341],[181,370,462,355,1300,693,715,391,568,486,896,342,560]],"speakerNameZh":"巴拿羅西亞","speakerGlyphs":[85,78,74,86,43],"portraitId":27,"linesZhTw":["『約拿先生也在這裡？好極了","　，這場仗也算上我一份！』"],"linesZhCn":["『约拿先生也在这里？好极了","　，这场仗也算上我一份！』"],"linesEn":["Master Jonah is here too? Splendid!","Count me in for this fight!"]}],[{"speaker":81,"boxPos":"top","lines":[[557,584,629,411,344,584,629,411,344,462,608,188,143],[181,592,654,697,570,964,965,584,584,560]],"speakerSlot":16,"speakerNameZh":"狂戰士","speakerGlyphs":[111,105,93],"portraitId":81,"linesZhTw":["『…為什麼…為什麼這些小鬼","　竟然如此厲害……』"],"linesZhCn":["『…为什么…为什么这些小鬼","　竟然如此厉害……』"],"linesEn":["...Why... how can these brats be so strong...?"]}],[{"speaker":27,"boxPos":"top","lines":[[557,462,355,1300,373,367,589,343,648,649,342,716,1135],[181,750,751,367,979,371,370,568,463,98,589,343,722],[181,782,1335,287,581,560]],"speakerNameZh":"巴拿羅西亞","speakerGlyphs":[85,78,74,86,43],"portraitId":27,"linesZhTw":["『這場仗打的真是漂亮！對於","　各位的表現，我個人真是非","　常佩服。』"],"linesZhCn":["『这场仗打的真是漂亮！对于","　各位的表现，我个人真是非","　常佩服。』"],"linesEn":["What a magnificent battle!","I am thoroughly impressed by everyone's prowess."]},{"speaker":16,"boxPos":"bottom","lines":[[557,85,78,74,86,43,1336,559,370,1079,559,346,343],[181,647,404,395,486,381,367,338,180,560]],"speakerNameZh":"凱拉斯","speakerGlyphs":[58,68,45],"portraitId":16,"linesZhTw":["『巴拿羅西亞閣下，陛下不是","　和您在一起的嗎？』"],"linesZhCn":["『巴拿罗西亚阁下，陛下不是","　和您在一起的吗？』"],"linesEn":["Lord Banarossia, wasn't His Majesty with you?"]},{"speaker":27,"boxPos":"top","lines":[[557,464,370,568,845,671,659,387,367,370,508,579,605],[181,343,83,84,68,45,367,1001,559,584,584,560]],"speakerNameZh":"巴拿羅西亞","speakerGlyphs":[85,78,74,86,43],"portraitId":27,"linesZhTw":["『啊，我早該想到的，原來你","　是聖寇拉斯的部下……』"],"linesZhCn":["『啊，我早该想到的，原来你","　是圣寇拉斯的部下……』"],"linesEn":["Ah, I should have guessed—so you serve St. Colas now..."]},{"speaker":16,"boxPos":"bottom","lines":[[557,343,367,370,568,569,395,279,449,515,516,153,154],[181,367,492,331,363,371,1100,515,516,1398,1399,1102,395],[181,570,455,399,370,1079,559,1056,255,175,569,367,130]],"speakerNameZh":"凱拉斯","speakerGlyphs":[58,68,45],"portraitId":16,"linesZhTw":["『是的，我們在行經死亡沼澤","　的途中發現「死亡骷髏」在","　此出沒，陛下擔心他們的目"],"linesZhCn":["『是的，我们在行经死亡沼泽","　的途中发现「死亡骷髅」在","　此出没，陛下担心他们的目"],"linesEn":["Indeed. While passing through the Swamp of Death, we spotted the Death Skulls lurking nearby.","His Majesty was worried you might be their target..."]},{"speaker":16,"boxPos":"bottom","lines":[[181,1430,65,428,343,605,569,370,628,401,259,913,568],[181,199,579,1040,658,486,790,581,560]],"speakerNameZh":"凱拉斯","speakerGlyphs":[58,68,45],"portraitId":16,"linesZhTw":["　標可能是你們，所以命令我","　先來查看一番。』"],"linesZhCn":["　标可能是你们，所以命令我","　先来查看一番。』"],"linesEn":["...so he ordered me to scout ahead and investigate."]},{"speaker":21,"boxPos":"bottom","lines":[[557,508,579,697,570,584,584,151,175,491,857,613,380],[181,341,180,560]],"speakerNameZh":"約拿","speakerGlyphs":[77,78],"portraitId":21,"linesZhTw":["『原來如此……那他往哪裡去","　了？』"],"linesZhCn":["『原来如此……那他往哪里去","　了？』"],"linesEn":["I see... Where did he head off to, then?"]},{"speaker":27,"boxPos":"top","lines":[[557,1079,559,534,175,339,449,363,371,341,486,608,1431],[181,1432,201,1433,370,334,606,491,86,524,753,1434,486],[181,1053,370,568,659,371,395,866,671,465,395,794,391]],"speakerNameZh":"巴拿羅西亞","speakerGlyphs":[85,78,74,86,43],"portraitId":27,"linesZhTw":["『陛下說他已經發現了一些蛛","　絲馬跡，要趕往西方高塔一","　趟，我想現在應該還在路上"],"linesZhCn":["『陛下说他已经发现了一些蛛","　丝马迹，要赶往西方高塔一","　趟，我想现在应该还在路上"],"linesEn":["His Majesty said he uncovered some clues and rushed off to the western tower.","I imagine he is still on the road..."]},{"speaker":27,"boxPos":"top","lines":[[181,358,581,560]],"speakerNameZh":"巴拿羅西亞","speakerGlyphs":[85,78,74,86,43],"portraitId":27,"linesZhTw":["　吧。』"],"linesZhCn":["　吧。』"],"linesEn":["...even as we speak."]},{"speaker":13,"boxPos":"bottom","lines":[[557,86,524,753,1434,584,584,151,346,345,343,1100,83],[181,100,132,1434,1102,338,180,151,613,343,568,569,99],[181,100,170,367,363,1435,83,114,370,659,346,387,389]],"speakerNameZh":"貝克威","speakerGlyphs":[60,61,62],"portraitId":13,"linesZhTw":["『西方高塔……那不就是「聖","　靈之塔」嗎？那裡是我們精","　靈族的發源聖地，想不到敵"],"linesZhCn":["『西方高塔……那不就是「圣","　灵之塔」吗？那里是我们精","　灵族的发源圣地，想不到敌"],"linesEn":["The western tower... Isn't that the Tower of Holy Spirits?","That is the sacred ancestral sanctuary of our elven people! To think the enemy has their eyes on it..."]},{"speaker":13,"boxPos":"bottom","lines":[[181,98,693,658,391,341,151,613,370,346,529,300,175],[181,569,400,893,692,1352,180,560]],"speakerNameZh":"貝克威","speakerGlyphs":[60,61,62],"portraitId":13,"linesZhTw":["　人也看上了那裡，不知道他","　們有何意圖？』"],"linesZhCn":["　人也看上了那里，不知道他","　们有何意图？』"],"linesEn":["What could they possibly be plotting there?"]},{"speaker":21,"boxPos":"bottom","lines":[[557,714,132,370,568,569,334,1178,607,647,83,84,68],[181,45,458,294,370,658,579,175,339,363,371,341,296],[181,334,367,1436,36,370,491,733,367,694,266,65,428]],"speakerNameZh":"約拿","speakerGlyphs":[77,78],"portraitId":21,"linesZhTw":["『總之，我們要儘快和聖寇拉","　斯會合，看來他已發現了重","　要的線索，往後的幾天可能"],"linesZhCn":["『总之，我们要尽快和圣寇拉","　斯会合，看来他已发现了重","　要的线索，往后的几天可能"],"linesEn":["In any case, we must rendezvous with St. Colas as soon as possible.","He seems to have found crucial clues. For the next few days, we'll need to force-march..."]},{"speaker":21,"boxPos":"bottom","lines":[[181,386,606,486,559,794,370,125,137,133,317,486,448],[181,581,560]],"speakerNameZh":"約拿","speakerGlyphs":[77,78],"portraitId":21,"linesZhTw":["　得趕一下路，大家忍耐一點","　。』"],"linesZhCn":["　得赶一下路，大家忍耐一点","　。』"],"linesEn":["...so bear with the pace, everyone."]},{"speaker":0,"boxPos":"bottom","lines":[[557,462,400,411,344,637,638,342,784,343,77,78,199],[181,258,404,699,536,339,125,370,65,346,334,797,1064],[181,820,403,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『這有什麼問題！倒是約拿先","　生您年事已大，可不要太勉","　強喔！』"],"linesZhCn":["『这有什么问题！倒是约拿先","　生您年事已大，可不要太勉","　强喔！』"],"linesEn":["No problem at all!","Though given your advanced years, Master Jonah, be sure not to push yourself too hard!"]},{"speaker":21,"boxPos":"bottom","lines":[[557,957,957,584,36,37,370,82,82,605,367,762,255],[181,370,568,458,1278,692,367,581,568,569,462,345,391],[181,794,358,342,560]],"speakerNameZh":"約拿","speakerGlyphs":[77,78],"portraitId":21,"linesZhTw":["『呵呵…索爾，謝謝你的關心","　，我會注意的。我們這就上","　路吧！』"],"linesZhCn":["『呵呵…索尔，谢谢你的关心","　，我会注意的。我们这就上","　路吧！』"],"linesEn":["Heh heh... Thank you for your concern, Thor. I'll be careful.","Come, let us be on our way!"]}]]}