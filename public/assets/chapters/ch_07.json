Glyphs":[95,94],"portraitId":82,"spriteGroup":82,"faction":"enemy","classId":3,"moveMode":"cavalry","aiMode":0,"aiTargetX":0,"aiTargetY":0,"aiChestIdx":1,"level":12,"x":13,"y":7,"maxHp":180,"maxMp":0,"baseAp":96,"baseDp":12,"baseDx":12,"mv":7,"items":[21,134],"spells":[],"waveGroup":10,"isBoss":false,"drop":null},{"index":38,"urecIndex":38,"uid":82,"nameZh":"騎兵","nameGlyphs":[95,94],"classNameZh":"騎兵","classGlyphs":[95,94],"portraitId":82,"spriteGroup":82,"faction":"enemy","classId":3,"moveMode":"cavalry","aiMode":0,"aiTargetX":0,"aiTargetY":0,"aiChestIdx":1,"level":12,"x":15,"y":7,"maxHp":180,"maxMp":0,"baseAp":96,"baseDp":12,"baseDx":12,"mv":7,"items":[21,134],"spells":[],"waveGroup":10,"isBoss":false,"drop":null}],"dialogues":[[{"speaker":13,"boxPos":"top","lines":[[557,658,342,497,1095,345,395,256,493,341,342,560]],"speakerNameZh":"貝克威","speakerGlyphs":[60,61,62],"portraitId":13,"linesZhTw":["『看！城堡就在眼前了！』"],"linesZhCn":["『看！城堡就在眼前了！』"],"linesEn":["Look! The castle is right before our eyes!"]},{"speaker":4,"boxPos":"bottom","lines":[[557,65,343,370,568,569,486,794,391,669,654,634,399],[181,774,387,389,361,370,723,722,584,584,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『可是，我們一路上居然都沒","　遇到敵軍，莫非……』"],"linesZhCn":["『可是，我们一路上居然都没","　遇到敌军，莫非……』"],"linesEn":["Still, we haven't run into a single enemy patrol along the way.","Could it be...?"]},{"speaker":1,"boxPos":"bottom","lines":[[557,605,534,716,643,370,175,569,634,395,462,613,352],[181,568,569,470,342,560]],"speakerNameZh":"哈諾","speakerGlyphs":[38,39],"portraitId":1,"linesZhTw":["『你說對啦，他們都在這裡等","　我們呢！』"],"linesZhCn":["『你说对啦，他们都在这里等","　我们呢！』"],"linesEn":["You called it!","They've all been waiting right here for us!"]},{"speaker":83,"boxPos":"top","lines":[[557,125,670,367,127,1031,370,346,852,605,569,400,70],[181,964,965,370,462,613,345,343,605,569,367,931,390],[181,132,717,341,342,560]],"speakerNameZh":"突擊騎兵","speakerGlyphs":[112,113,95,94],"portraitId":83,"linesZhTw":["『大膽的盜匪，不管你們有多","　厲害，這裡就是你們的葬身","　之處了！』"],"linesZhCn":["『大胆的盗匪，不管你们有多","　厉害，这里就是你们的葬身","　之处了！』"],"linesEn":["Insolent bandits! No matter how formidable you think you are,","this place shall be your grave!"]},{"speaker":8,"boxPos":"bottom","lines":[[557,352,352,342,125,137,561,568,534,370,346,334,313],[181,373,341,342,568,569,346,343,389,98,584,584,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『等等！大家聽我說，不要再","　打了！我們不是敵人……』"],"linesZhCn":["『等等！大家听我说，不要再","　打了！我们不是敌人……』"],"linesEn":["Wait! Everyone, please listen to me and stop fighting!","We are not your enemies..."]},{"speaker":83,"boxPos":"top","lines":[[557,605,569,401,629,462,719,652,568,458,791,792,180],[181,605,569,721,568,343,257,1096,338,180,560]],"speakerNameZh":"突擊騎兵","speakerGlyphs":[112,113,95,94],"portraitId":83,"linesZhTw":["『你們以為這種話我會相信？","　你們當我是白凝嗎？』"],"linesZhCn":["『你们以为这种话我会相信？","　你们当我是白凝吗？』"],"linesEn":["Do you truly expect me to swallow that?","Do you take me for a fool?!"]},{"speaker":8,"boxPos":"bottom","lines":[[557,306,1097,134,342,369,358,370,605,591,591,462,343],[181,411,344,180,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『無禮者！好吧，你瞧瞧這是","　什麼？』"],"linesZhCn":["『无礼者！好吧，你瞧瞧这是","　什么？』"],"linesEn":["Insolent cur! Very well, take a look at this!"]},{"speaker":83,"boxPos":"top","lines":[[557,701,342,462,343,584,462,343,676,978,307,1098,628],[181,1099,400,367,1100,161,157,132,1101,1102,191,1103,342],[181,462,191,1103,866,671,343,395,776,881,367,118,331]],"speakerNameZh":"突擊騎兵","speakerGlyphs":[112,113,95,94],"portraitId":83,"linesZhTw":["『咦！這是…這是歷代王后所","　擁有的「女神之淚」首飾！","　這首飾應該是在公主的手中"],"linesZhCn":["『咦！这是…这是历代王后所","　拥有的「女神之泪」首饰！","　这首饰应该是在公主的手中"],"linesEn":["Wh-What?! This is... the Tear of the Goddess,","the pendant passed down through our queens!","This heirloom should be in the Princess's hands..."]},{"speaker":83,"boxPos":"top","lines":[[181,370,640,300,584,584,560]],"speakerNameZh":"突擊騎兵","speakerGlyphs":[112,113,95,94],"portraitId":83,"linesZhTw":["　，難道……』"],"linesZhCn":["　，难道……』"],"linesEn":["Could you truly be...?"]},{"speaker":8,"boxPos":"bottom","lines":[[557,399,950,370,568,345,343,43,61,45,307,745,367],[181,776,881,51,52,43,370,568,401,776,881,132,902],[181,259,913,605,569,1050,1051,706,381,108,454,342,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『沒錯，我就是亞克斯王國的","　公主希莉亞，我以公主之名","　命令你們立刻收起武器！』"],"linesZhCn":["『没错，我就是亚克斯王国的","　公主希莉亚，我以公主之名","　命令你们立刻收起武器！』"],"linesEn":["Indeed. I am Celia, Princess of the Kingdom of Ax!","By my royal name, I command you to sheath your weapons at once!"]},{"speaker":83,"boxPos":"top","lines":[[557,65,584,65,343,584,1104,559,404,569,435,113,568],[181,361,367,532,1040,140,510,93,94,370,570,536,934],[181,989,555,1105,370,629,893,1104,559,404,458,584,560]],"speakerNameZh":"突擊騎兵","speakerGlyphs":[112,113,95,94],"portraitId":83,"linesZhTw":["『可…可是…殿下您們攻擊我","　軍的探查隊與士兵，此事證","　據確鑿，為何殿下您會…』"],"linesZhCn":["『可…可是…殿下您们攻击我","　军的探查队与士兵，此事证","　据确凿，为何殿下您会…』"],"linesEn":["B-But Your Highness... you ambushed our scouts and soldiers!","The evidence is indisputable. Why would Your Highness...?"]},{"speaker":8,"boxPos":"bottom","lines":[[557,568,569,647,175,569,801,363,258,341,448,817,458],[181,462,608,93,94,582,629,908,625,370,346,1041,561],[181,568,534,1074,370,865,369,199,378,175,569,373,363]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『我們和他們間發生了點誤會","　這些士兵極為蠻橫，不肯聽","　我說明，只好先把他們打發"],"linesZhCn":["『我们和他们间发生了点误会","　这些士兵极为蛮横，不肯听","　我说明，只好先把他们打发"],"linesEn":["It was merely a misunderstanding! Those soldiers were so belligerent","and refused to hear reason, so we had to teach them a lesson..."]},{"speaker":8,"boxPos":"bottom","lines":[[181,595,643,342,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["　掉啦！』"],"linesZhCn":["　掉啦！』"],"linesEn":["...and send them on their way!"]},{"speaker":5,"boxPos":"top","lines":[[557,140,141,370,462,367,555,343,776,881,1104,559,399],[181,950,342,568,569,199,408,580,776,881,364,497,370],[181,1106,536,401,733,313,534,584,584,560]],"speakerNameZh":"洛娜","speakerGlyphs":[46,47],"portraitId":5,"linesZhTw":["『隊長，這的確是公主殿下沒","　錯！我們先迎接公主進城，","　餘事以後再說……』"],"linesZhCn":["『队长，这的确是公主殿下没","　错！我们先迎接公主进城，","　余事以后再说……』"],"linesEn":["Captain, that is unmistakably Her Highness!","Let us escort the Princess into the castle first, and sort out the rest later..."]},{"speaker":83,"boxPos":"top","lines":[[557,462,584,462,672,344,279,342,1079,559,911,906,1107],[181,1108,370,334,568,378,462,608,655,1109,438,545,370],[181,568,681,399,400,827,387,370,345,343,1110,661,307]],"speakerNameZh":"突擊騎兵","speakerGlyphs":[112,113,95,94],"portraitId":83,"linesZhTw":["『這…這怎麼行！陛下親自吩","　咐，要我把這些亂黨消滅，","　我若沒有做到，就是違抗王"],"linesZhCn":["『这…这怎么行！陛下亲自吩","　咐，要我把这些乱党消灭，","　我若没有做到，就是违抗王"],"linesEn":["Th-That's out of the question! His Majesty personally commanded me","to wipe out these rebels. If I fail to do so,"]},{"speaker":83,"boxPos":"top","lines":[[181,259,342,560]],"speakerNameZh":"突擊騎兵","speakerGlyphs":[112,113,95,94],"portraitId":83,"linesZhTw":["　命！』"],"linesZhCn":["　命！』"],"linesEn":["...it would be defiance of the royal decree!"]},{"speaker":5,"boxPos":"top","lines":[[557,65,343,584,584,560]],"speakerNameZh":"洛娜","speakerGlyphs":[46,47],"portraitId":5,"linesZhTw":["『可是……』"],"linesZhCn":["『可是……』"],"linesEn":["But, Captain..."]},{"speaker":83,"boxPos":"top","lines":[[557,346,689,70,534,341,342,469,767,1110,661,307,259],[181,370,486,1111,135,306,662,342,702,703,569,391,464],[181,342,560]],"speakerNameZh":"突擊騎兵","speakerGlyphs":[112,113,95,94],"portraitId":83,"linesZhTw":["『不用多說了！誰敢違抗王命","　，一律殺無赦！弟兄們上啊","　！』"],"linesZhCn":["『不用多说了！谁敢违抗王命","　，一律杀无赦！弟兄们上啊","　！』"],"linesEn":["Enough! Anyone who defies the King's decree will be shown no mercy!","Men, charge! Cut them down!"]}],[{"speaker":5,"boxPos":"top","lines":[[557,776,881,370,583,379,255,342,568,390,629,1037,79],[181,1013,137,367,98,370,486,360,458,1112,259,653,194],[181,583,367,342,560]],"speakerNameZh":"洛娜","speakerGlyphs":[46,47],"portraitId":5,"linesZhTw":["『公主，妳放心！我身為史卡","　迪家的人，一定會捨命保護","　妳的！』"],"linesZhCn":["『公主，你放心！我身为史卡","　迪家的人，一定会舍命保护","　你的！』"],"linesEn":["Have no fear, Princess! As a knight of House Scadi,","I will protect you with my very life!"]},{"speaker":83,"boxPos":"top","lines":[[557,46,47,370,583,592,767,1110,1113,568,367,259,913],[181,342,583,693,803,402,515,358,342,560]],"speakerNameZh":"突擊騎兵","speakerGlyphs":[112,113,95,94],"portraitId":83,"linesZhTw":["『洛娜，妳竟敢違逆我的命令","　！妳也準備死吧！』"],"linesZhCn":["『洛娜，你竟敢违逆我的命令","　！你也准备死吧！』"],"linesEn":["Lorna, you dare turn your blade against my command?!","Then prepare to die with them!"]}],[{"speaker":83,"boxPos":"top","lines":[[557,776,881,1104,559,584,584,724,559,693,343,1114,259],[181,279,536,370,1115,961,132,717,370,350,404,508,1080],[181,584,584,464,584,584,560]],"speakerNameZh":"突擊騎兵","speakerGlyphs":[112,113,95,94],"portraitId":83,"linesZhTw":["『公主殿下……屬下也是遵命","　行事，冒犯之處，請您原諒","　……啊……』"],"linesZhCn":["『公主殿下……属下也是遵命","　行事，冒犯之处，请您原谅","　……啊……』"],"linesEn":["Princess... I was only... following orders...","Forgive my... insolence... Urgh..."]}],[{"speaker":8,"boxPos":"bottom","lines":[[557,825,342,536,816,629,411,344,458,1116,542,462,696],[181,584,584,568,386,380,788,1117,307,486,651,370],[181,378,536,816,1059,463,822,823,755,279,581,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『唉！事情為什麼會變成這樣","　……我得去見父王一面，","　把事情弄個清楚才行。』"],"linesZhCn":["『唉！事情为什么会变成这样","　……我得去见父王一面，","　把事情弄个清楚才行。』"],"linesEn":["Sigh... How did things ever come to this?","I must see Father at once and get to the bottom of everything."]},{"speaker":5,"boxPos":"top","lines":[[557,776,881,1104,559,370,371,395,1118,331,816,1119,1120],[181,655,370,350,1121,724,559,935,279,370,401,653,194],[181,1104,559,367,930,362,581,560]],"speakerNameZh":"洛娜","speakerGlyphs":[46,47],"portraitId":5,"linesZhTw":["『公主殿下，現在宮中情勢混","　亂，請容屬下隨行，以保護","　殿下的安全。』"],"linesZhCn":["『公主殿下，现在宫中情势混","　乱，请容属下随行，以保护","　殿下的安全。』"],"linesEn":["Princess Celia, the royal court is in utter disarray.","Please allow me to escort you and guard Your Highness."]},{"speaker":8,"boxPos":"bottom","lines":[[557,860,755,583,534,583,343,1037,79,1013,137,367,98],[181,584,584,65,343,222,95,93,168,137,367,1037,79],[181,1013,137,170,180,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『剛才妳說妳是史卡迪家的人","　……可是指騎士世家的史卡","　迪家族？』"],"linesZhCn":["『刚才你说你是史卡迪家的人","　……可是指骑士世家的史卡","　迪家族？』"],"linesEn":["You mentioned earlier you are from House Scadi...","Do you belong to the renowned knightly Scadi lineage?"]},{"speaker":5,"boxPos":"top","lines":[[557,343,367,342,568,1037,79,1013,137,367,170,98,168],[181,978,634,1056,897,653,194,307,170,367,424,259,370],[181,697,744,877,654,568,137,170,865,941,559,568,486]],"speakerNameZh":"洛娜","speakerGlyphs":[46,47],"portraitId":5,"linesZhTw":["『是的！我史卡迪家的族人世","　代都擔負保護王族的使命，","　如今雖然我家族只剩下我一"],"linesZhCn":["『是的！我史卡迪家的族人世","　代都担负保护王族的使命，","　如今虽然我家族只剩下我一"],"linesEn":["Yes! For generations, House Scadi has dedicated itself","to safeguarding the royal family.","Though I am the sole survivor left of my house..."]},{"speaker":5,"boxPos":"top","lines":[[181,463,98,370,724,559,1122,458,888,1123,541,149,370],[181,1124,401,442,259,653,194,1104,559,367,930,362,581],[181,560]],"speakerNameZh":"洛娜","speakerGlyphs":[46,47],"portraitId":5,"linesZhTw":["　個人，屬下仍會盡忠職守，","　誓以性命保護殿下的安全。","　』"],"linesZhCn":["　个人，属下仍会尽忠职守，","　誓以性命保护殿下的安全。","　』"],"linesEn":["...I will steadfastly fulfill my duty and swear upon my life","to ensure Your Highness's safety!"]},{"speaker":8,"boxPos":"bottom","lines":[[557,568,1074,257,341,370,583,345,889,568,579,358,584],[181,584,36,37,370,43,44,45,370,401,733,568,465],[181,334,1125,296,605,569,367,213,214,370,605,569,693]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『我明白了，妳就跟我來吧…","　…索爾，亞雷斯，以後我還","　要借重你們的力量，你們也"],"linesZhCn":["『我明白了，你就跟我来吧…","　…索尔，亚雷斯，以后我还","　要借重你们的力量，你们也"],"linesEn":["I understand. Come with me, then.","Thor, Ares, I will need your strength in the days ahead as well."]},{"speaker":8,"boxPos":"bottom","lines":[[181,647,568,486,381,364,497,358,342,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["　和我一起進城吧！』"],"linesZhCn":["　和我一起进城吧！』"],"linesEn":["Please, come enter the castle with me!"]}],[{"speaker":0,"boxPos":"bottom","lines":[[557,51,52,43,584,584,343,307,745,776,881,180],[181,151,53,54,367,390,896,712,343,672,344],[181,486,310,536,180,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『希莉亞……是王國公主？","　那悠妮的身份又是怎麼","　一回事？』"],"linesZhCn":["『希莉亚……是王国公主？","　那悠妮的身份又是怎么","　一回事？』"],"linesEn":["Celia is... the kingdom's princess?","Then what about Uni? Who is she really?"]},{"speaker":4,"boxPos":"bottom","lines":[[557,738,873,874,370,343,568,569,665,950,643,581],[181,371,395,671,672,344,673,180,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『很簡單，是我們搞錯啦。","　現在該怎麼辦？』"],"linesZhCn":["『很简单，是我们搞错啦。","　现在该怎么办？』"],"linesEn":["Simple enough—we had it wrong all along.","What's our move now?"]},{"speaker":0,"boxPos":"bottom","lines":[[557,536,387,697,744,370,693,865,400,889,690,51,52],[181,43,364,380,658,658,341,581,806,358,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『事到如今，也只有跟著希莉","　亞進去看看了。走吧！』"],"linesZhCn":["『事到如今，也只有跟着希莉","　亚进去看看了。走吧！』"],"linesEn":["At this point, our only choice is to follow Celia and see for ourselves.","Let's move!"]}]]}