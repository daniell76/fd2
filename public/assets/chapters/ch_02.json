ortraitId":77,"spriteGroup":77,"faction":"enemy","classId":2,"moveMode":"foot","aiMode":0,"aiTargetX":0,"aiTargetY":0,"aiChestIdx":1,"level":5,"x":8,"y":25,"maxHp":90,"maxMp":0,"baseAp":40,"baseDp":20,"baseDx":10,"mv":4,"items":[1,129,192],"spells":[],"waveGroup":2,"isBoss":true,"drop":{"type":"dialogue","value":5}}],"dialogues":[[{"speaker":8,"boxPos":"top","lines":[[557,563,341,462,148,900,370,345,607,387,401,867,136],[181,901,902,367,903,68,162,341,581,462,162,291,331],[181,367,126,298,867,417,81,136,722,782,157,885,370]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『過了這座橋，就快到以醫術","　聞名的賽拉村了。這村子中","　的祭司醫療法術非常神奇，"],"linesZhCn":["『过了这座桥，就快到以医术","　闻名的赛拉村了。这村子中","　的祭司医疗法术非常神奇，"],"linesEn":["Once we cross this bridge, we'll nearly be at Sera Village, renowned for its medicine.","The priests there possess miraculous healing magic..."]},{"speaker":8,"boxPos":"top","lines":[[181,866,671,428,416,369,53,54,367,439,868,869,581],[181,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["　應該能治好悠妮的失憶症。","　』"],"linesZhCn":["　应该能治好悠妮的失忆症。","　』"],"linesEn":["...which should be able to cure Uni's amnesia."]},{"speaker":0,"boxPos":"bottom","lines":[[557,51,786,697,570,584,701,584,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『希望如此…咦…』"],"linesZhCn":["『希望如此…咦…』"],"linesEn":["I certainly hope so... Wait, what's that...?"]}],[{"speaker":2,"boxPos":"top","lines":[[557,584,522,370,462,310,125,713,343,904,346,391,341],[181,584,584,560]],"speakerNameZh":"鐵諾","speakerGlyphs":[40,39],"portraitId":2,"linesZhTw":["『…呼，這回大概是追不上了","　……』"],"linesZhCn":["『…呼，这回大概是追不上了","　……』"],"linesEn":["*pant*... *pant*... Looks like I've finally lost them..."]}],[{"speaker":76,"boxPos":"top","lines":[[557,40,39,370,714,715,904,391,605,341,358,342],[181,462,559,291,658,605,672,344,821,342,560]],"speakerSlot":7,"speakerNameZh":"士兵","speakerGlyphs":[93,94],"portraitId":76,"linesZhTw":["『鐵諾，總算追上你了吧！","　這下子看你怎麼逃！』"],"linesZhCn":["『铁诺，总算追上你了吧！","　这下子看你怎么逃！』"],"linesEn":["Tieno! Caught up with you at last!","Let's see you try to escape now!"]},{"speaker":2,"boxPos":"bottom","lines":[[557,605,569,387,664,647,568,400,411,344,905,770,370],[181,722,386,334,135,515,568,346,65,180,342,560]],"speakerNameZh":"鐵諾","speakerGlyphs":[40,39],"portraitId":2,"linesZhTw":["『你們到底和我有什麼仇恨，","　非得要殺死我不可？！』"],"linesZhCn":["『你们到底和我有什么仇恨，","　非得要杀死我不可？！』"],"linesEn":["What grudge do you have against me that you're so hell-bent on taking my life?!"]},{"speaker":76,"boxPos":"top","lines":[[557,681,605,428,539,387,568,569,140,141,606,387,367],[181,575,576,370,605,313,906,907,380,637,175,358,342],[181,560]],"speakerSlot":7,"speakerNameZh":"士兵","speakerGlyphs":[93,94],"portraitId":76,"linesZhTw":["『若你能活到我們隊長趕到的","　時候，你再自己去問他吧！","　』"],"linesZhCn":["『若你能活到我们队长赶到的","　时候，你再自己去问他吧！","　』"],"linesEn":["If you manage to survive until our captain arrives, you can ask him yourself!"]},{"speaker":2,"boxPos":"bottom","lines":[[557,65,102,342,568,647,605,569,769,341,342,560]],"speakerNameZh":"鐵諾","speakerGlyphs":[40,39],"portraitId":2,"linesZhTw":["『可惡！我和你們拼了！』"],"linesZhCn":["『可恶！我和你们拼了！』"],"linesEn":["Curse you! Then I'll take you all down with me!"]}],[{"speaker":8,"boxPos":"top","lines":[[557,825,657,342,658,370,900,391,400,98,803,402,334],[181,373,630,618,342,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『唉呀！看，橋上有人準備要","　打架耶！』"],"linesZhCn":["『唉呀！看，桥上有人准备要","　打架耶！』"],"linesEn":["Oh my! Look, there's a fight brewing on the bridge!"]},{"speaker":0,"boxPos":"bottom","lines":[[557,401,70,373,447,370,462,797,346,776,507,341,342],[181,806,370,43,44,45,370,568,569,380,678,151,463],[181,413,874,367,98,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『以多打少，這太不公平了！","　走，亞雷斯，我們去幫那個","　落單的人！』"],"linesZhCn":["『以多打少，这太不公平了！","　走，亚雷斯，我们去帮那个","　落单的人！』"],"linesEn":["Outnumbering him like that is completely unfair!","Come on, Ares, let's go help that lone fighter!"]},{"speaker":4,"boxPos":"top","lines":[[557,36,37,370,568,569,465,399,665,822,823,462,343],[181,672,344,486,310,536,370,462,797,584,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『索爾，我們還沒搞清楚這是","　怎麼一回事，這太…』"],"linesZhCn":["『索尔，我们还没搞清楚这是","　怎么一回事，这太…』"],"linesEn":["Thor, wait! We don't even know what's going on yet! This is too—"]},{"speaker":0,"boxPos":"bottom","lines":[[557,658,151,608,93,94,908,346,909,271,367,696,291],[181,370,345,529,300,175,486,360,343,369,98,342],[181,43,44,45,370,605,387,664,380,346,380,180,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『看那些士兵蠻不講理的樣子","　，就知道他一定是好人！","　亞雷斯，你到底去不去？』"],"linesZhCn":["『看那些士兵蛮不讲理的样子","　，就知道他一定是好人！","　亚雷斯，你到底去不去？』"],"linesEn":["Just look at how unreasonable those soldiers are—he's got to be the good guy!","Ares, are you coming or not?!"]},{"speaker":4,"boxPos":"top","lines":[[557,380,370,380,342,568,714,346,428,658,690,605,486],[181,463,98,380,769,259,370,910,789,605,715,568,784],[181,891,342,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『去，去！我總不能看著你一","　個人去拼命，認識你算我倒","　楣！』"],"linesZhCn":["『去，去！我总不能看着你一","　个人去拼命，认识你算我倒","　楣！』"],"linesEn":["Alright, alright! I can't just stand by and watch you get yourself killed.","Meeting you was the worst luck of my life!"]},{"speaker":8,"boxPos":"top","lines":[[557,568,693,380,342,568,693,380,342,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『我也去！我也去！』"],"linesZhCn":["『我也去！我也去！』"],"linesEn":["Count me in! I'm coming too!"]},{"speaker":1,"boxPos":"top","lines":[[557,843,654,697,570,370,151,344,125,137,634,380,358],[181,342,806,807,342,560]],"speakerNameZh":"哈諾","speakerGlyphs":[38,39],"portraitId":1,"linesZhTw":["『既然如此，那麼大家都去吧","　！走囉！』"],"linesZhCn":["『既然如此，那么大家都去吧","　！走啰！』"],"linesEn":["Well, if that's how it is, let's all go! Move out!"]}],[{"speaker":77,"boxPos":"top","lines":[[557,40,39,370,605,437,654,738,317,259,342,155,346],[181,386,129,291,486,360,334,568,911,906,579,658,658],[181,584,584,346,563,370,605,367,369,531,693,387,570]],"speakerNameZh":"精英戰士","speakerGlyphs":[99,104,105,93],"portraitId":77,"linesZhTw":["『鐵諾，你果然很耐命！怪不","　得頭子一定要我親自來看看","　……不過，你的好運也到此"],"linesZhCn":["『铁诺，你果然很耐命！怪不","　得头子一定要我亲自来看看","　……不过，你的好运也到此"],"linesEn":["Tieno, you certainly are tough to kill! No wonder the boss insisted I see to this personally...","However, your luck..."]},{"speaker":77,"boxPos":"top","lines":[[181,629,622,341,342,560]],"speakerNameZh":"精英戰士","speakerGlyphs":[99,104,105,93],"portraitId":77,"linesZhTw":["　為止了！』"],"linesZhCn":["　为止了！』"],"linesEn":["...ends right here!"]},{"speaker":2,"boxPos":"bottom","lines":[[557,697,437,346,343,462,608,699,700,98,678,679,367],[181,652,370,568,845,345,399,259,341,342,346,563,843],[181,654,568,465,539,690,370,568,465,343,334,637,605]],"speakerNameZh":"鐵諾","speakerGlyphs":[40,39],"portraitId":2,"linesZhTw":["『如果不是這些年輕人幫忙的","　話，我早就沒命了！不過既","　然我還活著，我還是要問你"],"linesZhCn":["『如果不是这些年轻人帮忙的","　话，我早就没命了！不过既","　然我还活着，我还是要问你"],"linesEn":["If not for the help of these young warriors, I'd already be dead.","But since I'm still breathing, I have one question for you:"]},{"speaker":2,"boxPos":"bottom","lines":[[181,486,463,637,638,912,387,664,343,469,259,913,605],[181,579,135,568,180,560]],"speakerNameZh":"鐵諾","speakerGlyphs":[40,39],"portraitId":2,"linesZhTw":["　一個問題：到底是誰命令你","　來殺我？』"],"linesZhCn":["　一个问题：到底是谁命令你","　来杀我？』"],"linesEn":["Who gave the order to take my life?!"]},{"speaker":77,"boxPos":"top","lines":[[557,831,914,605,693,346,334,687,370,343,915,44,125],[181,98,259,913,568,569,579,551,595,605,367,342,560]],"speakerNameZh":"精英戰士","speakerGlyphs":[99,104,105,93],"portraitId":77,"linesZhTw":["『告訴你也不要緊，是葛雷大","　人命令我們來除掉你的！』"],"linesZhCn":["『告诉你也不要紧，是葛雷大","　人命令我们来除掉你的！』"],"linesEn":["I don't mind telling you—Lord Gray ordered us to eliminate you!"]},{"speaker":8,"boxPos":"bottom","lines":[[557,915,44,180,151,463,255,916,917,918,367,919,150],[181,361,553,252,180,343,629,341,167,699,493,920,921],[181,79,922,151,161,729,367,536,358,342,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『葛雷？那個心胸狹窄的禁衛","　軍統領？是為了三年前爭奪","　卡蘿那女孩的事吧！』"],"linesZhCn":["『葛雷？那个心胸狭窄的禁卫","　军统领？是为了三年前争夺","　卡萝那女孩的事吧！』"],"linesEn":["Gray? That petty, narrow-minded Royal Guard Commander?","Is this over that girl, Carona, three years ago?!"]},{"speaker":2,"boxPos":"bottom","lines":[[557,583,584,583,672,344,458,529,300,462,272,536,180],[181,560]],"speakerNameZh":"鐵諾","speakerGlyphs":[40,39],"portraitId":2,"linesZhTw":["『妳…妳怎麼會知道這件事？","　』"],"linesZhCn":["『你…你怎么会知道这件事？","　』"],"linesEn":["H-How... How could you possibly know about that?!"]},{"speaker":8,"boxPos":"bottom","lines":[[557,923,547,342,346,563,605,65,401,379,255,370,568],[181,569,634,458,678,605,367,581,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『秘密！不過你可以放心，我","　們都會幫你的。』"],"linesZhCn":["『秘密！不过你可以放心，我","　们都会帮你的。』"],"linesEn":["That's a secret! But don't worry, we're going to help you."]},{"speaker":77,"boxPos":"top","lines":[[557,65,102,342,678,175,367,634,386,515,370,893,337],[181,605,569,339,449,529,300,341,462,463,923,547,370],[181,151,345,683,155,568,346,836,816,342,468,568,135],[181,342,560]],"speakerNameZh":"精英戰士","speakerGlyphs":[99,104,105,93],"portraitId":77,"linesZhTw":["『可惡！幫他的都得死，何況","　你們已經知道了這個秘密，","　那就別怪我不留情！給我殺","　！』"],"linesZhCn":["『可恶！帮他的都得死，何况","　你们已经知道了这个秘密，","　那就别怪我不留情！给我杀","　！』"],"linesEn":["Curse you! Anyone who aids him dies! And since you know our secret, don't expect any mercy!","Kill them all!"]}],[{"speaker":77,"boxPos":"top","lines":[[557,568,592,654,458,778,395,486,624,188,143,367,118],[181,559,584,584,915,44,125,98,584,584,560]],"speakerNameZh":"精英戰士","speakerGlyphs":[99,104,105,93],"portraitId":77,"linesZhTw":["『我竟然會敗在一批小鬼的手","　下……葛雷大人……』"],"linesZhCn":["『我竟然会败在一批小鬼的手","　下……葛雷大人……』"],"linesEn":["To think I'd fall to a bunch of brats... Lord Gray..."]}],[{"speaker":0,"boxPos":"bottom","lines":[[557,589,924,925,370,568,569,339,449,888,213,341,370],[181,365,437,465,343,678,346,341,175,584,584,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『真遺憾，我們已經盡力了，","　結果還是幫不了他……』"],"linesZhCn":["『真遗憾，我们已经尽力了，","　结果还是帮不了他……』"],"linesEn":["What a tragedy... We gave it everything we had, but we still couldn't save him..."]},{"speaker":8,"boxPos":"top","lines":[[557,693,369,370,725,175,387,114,559,647,926,98,791],[181,927,370,693,346,689,313,480,717,862,928,683,98],[181,367,904,135,584,584,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『也好，讓他到地下和愛人相","　聚，也不用再四處躲避別人","　的追殺……』"],"linesZhCn":["『也好，让他到地下和爱人相","　聚，也不用再四处躲避别人","　的追杀……』"],"linesEn":["Perhaps it's for the best. Now he can reunite with his beloved in the afterlife, free from pursuit..."]},{"speaker":4,"boxPos":"bottom","lines":[[557,51,52,43,370,583,367,589,260,390,896,929,592],[181,343,411,344,180,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『希莉亞，妳的真實身份究竟","　是什麼？』"],"linesZhCn":["『希莉亚，你的真实身份究竟","　是什么？』"],"linesEn":["Celia, just who are you really?"]},{"speaker":8,"boxPos":"top","lines":[[557,923,547,342,714,132,370,568,569,930,931,175,132],[181,733,345,606,607,353,354,462,613,358,370,334,346],[181,654,367,652,370,316,720,65,428,465,395,733,129]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『秘密！總之，我們安葬他之","　後就趕快離開這裡吧，要不","　然的話，麻煩可能還在後頭"],"linesZhCn":["『秘密！总之，我们安葬他之","　后就赶快离开这里吧，要不","　然的话，麻烦可能还在后头"],"linesEn":["That's a secret! Regardless, let's bury him and leave at once.","Otherwise, even worse trouble..."]},{"speaker":8,"boxPos":"top","lines":[[181,470,342,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["　呢！』"],"linesZhCn":["　呢！』"],"linesEn":["...might be right behind us!"]},{"speaker":0,"boxPos":"bottom","lines":[[557,345,462,344,673,358,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『就這麼辦吧！』"],"linesZhCn":["『就这么办吧！』"],"linesEn":["Let's do that!"]}],[{"speaker":2,"boxPos":"top","lines":[[557,70,82,750,751,367,678,824,370,568,755,428,821],[181,563,462,819,904,135,581,346,563,915,44,343,346],[181,458,345,570,932,118,367,370,568,395,462,564,933]],"speakerNameZh":"鐵諾","speakerGlyphs":[40,39],"portraitId":2,"linesZhTw":["『多謝各位的幫助，我才能逃","　過這次追殺。不過葛雷是不","　會就此罷手的，我在這片土"],"linesZhCn":["『多谢各位的帮助，我才能逃","　过这次追杀。不过葛雷是不","　会就此罢手的，我在这片土"],"linesEn":["My deepest thanks to you all. Thanks to your help, I managed to survive.","Yet Gray will never stop hunting me, and I fear..."]},{"speaker":2,"boxPos":"top","lines":[[181,114,391,370,465,343,876,346,387,930,669,132,628],[181,584,584,560]],"speakerNameZh":"鐵諾","speakerGlyphs":[40,39],"portraitId":2,"linesZhTw":["　地上，還是找不到安居之所","　……』"],"linesZhCn":["　地上，还是找不到安居之所","　……』"],"linesEn":["...there is no longer any peaceful place for me in this land..."]},{"speaker":8,"boxPos":"bottom","lines":[[557,151,605,65,401,434,471,568,569,464,342,616,605],[181,462,696,602,677,367,105,93,370,716,568,569,579],[181,534,343,346,65,70,386,367,609,793,370,623,568]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『那你可以加入我們啊！像你","　這樣老練的戰士，對我們來","　說是不可多得的伙伴，而我"],"linesZhCn":["『那你可以加入我们啊！像你","　这样老练的战士，对我们来","　说是不可多得的伙伴，而我"],"linesEn":["Then why don't you join us?","A seasoned warrior like you would be an invaluable companion, and with all of us together..."]},{"speaker":8,"boxPos":"bottom","lines":[[181,569,486,611,98,395,486,381,370,568,653,934,915],[181,44,346,767,935,815,716,605,559,118,581,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["　們一群人在一起，我保證葛","　雷不敢隨便對你下手。』"],"linesZhCn":["　们一群人在一起，我保证葛","　雷不敢随便对你下手。』"],"linesEn":["...I guarantee Gray won't dare lay a finger on you."]},{"speaker":2,"boxPos":"top","lines":[[557,188,864,370,583,629,411,344,458,529,300,462,608],[181,536,370,568,584,560]],"speakerNameZh":"鐵諾","speakerGlyphs":[40,39],"portraitId":2,"linesZhTw":["『小姐，妳為什麼會知道這些","　事，我…』"],"linesZhCn":["『小姐，你为什么会知道这些","　事，我…』"],"linesEn":["Milady, just how do you know all this? I..."]},{"speaker":8,"boxPos":"bottom","lines":[[557,923,547,342,936,740,605,434,471,568,569,345,343],[181,341,581,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『秘密！反正你加入我們就是","　了。』"],"linesZhCn":["『秘密！反正你加入我们就是","　了。』"],"linesEn":["That's a secret! Just join us and that's that."]},{"speaker":0,"boxPos":"bottom","lines":[[557,711,342,486,937,938,445,157,923,367,696,291,370],[181,589,343,463,521,100,99,155,367,859,129,581,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『哼！一副故作神秘的樣子，","　真是個古靈精怪的丫頭。』"],"linesZhCn":["『哼！一副故作神秘的样子，","　真是个古灵精怪的丫头。』"],"linesEn":["Hmph! Always acting so mysterious. What an eccentric girl."]},{"speaker":8,"boxPos":"bottom","lines":[[557,605,534,411,344,180,568,65,343,395,629,605,569],[181,433,434,400,213,367,609,793,470,342,560]],"speakerNameZh":"希莉亞","speakerGlyphs":[51,52,43],"portraitId":8,"linesZhTw":["『你說什麼？我可是在為你們","　增加有力的伙伴呢！』"],"linesZhCn":["『你说什么？我可是在为你们","　增加有力的伙伴呢！』"],"linesEn":["What did you say?! I'm bringing us a powerful ally, you know!"]},{"speaker":0,"boxPos":"bottom","lines":[[557,346,51,939,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『不希罕！』"],"linesZhCn":["『不希罕！』"],"linesEn":["Nobody asked you to!"]},{"speaker":2,"boxPos":"top","lines":[[557,568,339,449,359,360,341,370,697,437,750,751,346],[181,940,393,568,367,652,370,401,733,345,350,70,70],[181,762,834,581,560]],"speakerNameZh":"鐵諾","speakerGlyphs":[40,39],"portraitId":2,"linesZhTw":["『我已經決定了，如果各位不","　嫌棄我的話，以後就請多多","　關照。』"],"linesZhCn":["『我已经决定了，如果各位不","　嫌弃我的话，以后就请多多","　关照。』"],"linesEn":["I've made up my mind. If you'll have me, I would be honored to join you."]},{"speaker":4,"boxPos":"bottom","lines":[[557,407,408,342,346,563,370,568,569,465,343,606,607],[181,353,354,570,114,370,941,559,367,536,401,733,313],[181,534,341,342,560]],"speakerNameZh":"亞雷斯","speakerGlyphs":[43,44,45],"portraitId":4,"linesZhTw":["『歡迎！不過，我們還是趕快","　離開此地，剩下的事以後再","　說了！』"],"linesZhCn":["『欢迎！不过，我们还是赶快","　离开此地，剩下的事以后再","　说了！』"],"linesEn":["Welcome aboard! But let's get out of here right away—we can discuss the rest later!"]},{"speaker":1,"boxPos":"bottom","lines":[[557,534,386,716,370,568,569,391,794,358,342,560]],"speakerNameZh":"哈諾","speakerGlyphs":[38,39],"portraitId":1,"linesZhTw":["『說得對，我們上路吧！』"],"linesZhCn":["『说得对，我们上路吧！』"],"linesEn":["Well said! Let's hit the road!"]}],[{"speaker":0,"boxPos":"bottom","lines":[[557,462,584,584,462,343,411,344,942,943,342,560]],"speakerNameZh":"索爾","speakerGlyphs":[36,37],"portraitId":0,"linesZhTw":["『這……這是什麼碗糕！』"],"linesZhCn":["『这……这是什么碗糕！』"],"linesEn":["Wh-What in the world is this thing?!"]}],[{"speaker":2,"boxPos":"top","lines":[[557,79,922,151,584,584,584,342,560]],"speakerSlot":6,"speakerNameZh":"鐵諾","speakerGlyphs":[40,39],"portraitId":2,"linesZhTw":["『卡蘿那………！』"],"linesZhCn":["『卡萝那………！』"],"linesEn":["Carona...!"]}]]}